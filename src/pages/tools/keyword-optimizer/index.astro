                startDrag = { x: e.clientX - transformState.x, y: e.clientY - transformState.y };
                mindmapSvg.style.cursor = 'grabbing';
            });
            mindmapSvg.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                transformState.x = e.clientX - startDrag.x;
                transformState.y = e.clientY - startDrag.y;
                const g = document.getElementById('mindmap-transform-group');
                if (g) g.setAttribute('transform', `translate(${transformState.x}, ${transformState.y}) scale(${transformState.scale})`);
            });
            mindmapSvg.addEventListener('mouseup', () => {
                isDragging = false;
                mindmapSvg.style.cursor = 'grab';
            });
            mindmapSvg.addEventListener('mouseleave', () => {
                isDragging = false;
                mindmapSvg.style.cursor = 'grab';
            });
            mindmapSvg.addEventListener('wheel', (e) => {
                e.preventDefault();
                const zoomIntensity = 0.1;
                const wheel = e.deltaY < 0 ? 1 : -1;
                const zoom = Math.exp(wheel * zoomIntensity);
                
                const rect = mindmapSvg.getBoundingClientRect();
                const mouseX = e.clientX - rect.left;
                const mouseY = e.clientY - rect.top;
                
                transformState.x = mouseX - (mouseX - transformState.x) * zoom;
                transformState.y = mouseY - (mouseY - transformState.y) * zoom;
                transformState.scale *= zoom;
                transformState.scale = Math.min(Math.max(transformState.scale, 0.3), 3);
                
                const g = document.getElementById('mindmap-transform-group');
