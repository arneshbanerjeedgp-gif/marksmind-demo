---
import '@fontsource/plus-jakarta-sans';
import { BotMessageSquare, BrainCircuit, Layers, UserCircle, Sparkles, Target, Home, GitFork } from 'lucide-astro';

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarksMind AI | Tools</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
        html, body { height: 100%; margin: 0; padding: 0; background-color: #0b0b0c; }
        .loader { border-top-color: #8b5cf6; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in { animation: fade-in 0.5s ease-out forwards; }
        input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        input[type=number] { -moz-appearance: textfield; }
        .sandbox-btn.active-question-card { border-color: #8b5cf6; box-shadow: 0 0 15px rgba(139, 92, 246, 0.3); }
        .tool-card { background-color: #161618; border: 1px solid #2a2a2c; transition: all 0.2s ease-in-out; }
        .tool-card:hover { border-color: #8b5cf6; transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="font-['Plus_Jakarta_Sans',sans-serif] antialiased">
    <div class="flex min-h-screen bg-[#0b0b0c] text-[#f3f3f4]">
        
        <aside class="w-64 border-r border-white/[0.05] bg-[#0e0e10] p-4 flex flex-col justify-between">
            <div>
                <div class="px-2 mb-8">
                    <h1 class="text-base font-semibold tracking-tight">MarksMind AI</h1>
                    <p class="text-xs text-[#9aa0a6]">Console</p>
                </div>
                <nav class="flex flex-col gap-2">
                     <a href="#" id="nav-dashboard" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                        <span>Dashboard</span>
                    </a>
                     <a href="#" id="nav-revision" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md">
                        <Sparkles class="w-5 h-5" />
                        <span>Smart Revision</span>
                    </a>
                    <a href="#" id="nav-mistake" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md text-slate-400 hover:bg-slate-800">
                        <Target class="w-5 h-5" />
                        <span>Mistake Database</span>
                    </a>
                    <a href="#" id="nav-evaluator" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md">
                        <BotMessageSquare class="w-5 h-5" />
                        <span>NCERT Answer Evaluator</span>
                    </a>
                    <a href="#" id="nav-quiz" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md text-slate-400 hover:bg-slate-800">
                        <BrainCircuit class="w-5 h-5" />
                        <span>Quiz Generator</span>
                    </a>
                    <a href="#" id="nav-flashcard" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md text-slate-400 hover:bg-slate-800">
                        <Layers class="w-5 h-5" />
                        <span>Flashcard Generator</span>
                    </a>
                    <a href="#" id="nav-mindmap" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md text-slate-400 hover:bg-slate-800">
                        <GitFork class="w-5 h-5" />
                        <span>Mind Map Generator</span>
                    </a>
                </nav>
            </div>
            <div class="border-t border-white/[0.05] pt-4 mt-auto">
                <div class="flex items-center gap-3">
                    <UserCircle class="w-9 h-9 text-[#4e525a]" />
                    <div>
                        <p class="text-sm font-medium text-[#f3f3f4]">Arnesh</p>
                        <p class="text-xs text-[#9aa0a6]">Premium Developer Plan</p>
                    </div>
                </div>
            </div>
        </aside>

        <main class="flex-1 p-8 md:p-12 overflow-y-auto bg-[#0b0b0c]">
             <!-- View -1: Dashboard -->
            <div id="dashboard-view">
                <div class="max-w-7xl mx-auto">
                     <div class="mb-8">
                        <h1 class="text-xl font-medium text-[#f3f3f4] tracking-tight">AI Command Center</h1>
                        <p class="mt-1 text-base text-[#9aa0a6]">Your comprehensive academic intelligence overview.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6 mt-4">
                        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-slate-700">
                            <p class="text-xs font-bold tracking-widest text-slate-500 uppercase mb-2">Overall Accuracy</p>
                            <p class="text-3xl font-extrabold text-emerald-400">82% <span class="text-lg">↑</span></p>
                        </div>
                        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-slate-700">
                            <p class="text-xs font-bold tracking-widest text-slate-500 uppercase mb-2">Syllabus Mastery</p>
                            <p class="text-3xl font-extrabold text-purple-400">68%</p>
                             <div class="w-full bg-slate-800 h-1.5 mt-3 rounded-full"><div class="bg-purple-500 w-[68%] h-1.5 rounded-full shadow-[0_0_10px_rgba(168,85,247,0.5)]"></div></div>
                        </div>
                        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-slate-700">
                            <p class="text-xs font-bold tracking-widest text-slate-500 uppercase mb-2">Active Streak</p>
                            <p class="text-3xl font-extrabold text-amber-400">14 Days 🔥</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6">
                             <h3 class="text-lg font-bold text-slate-200 mb-6">Subject Performance</h3>
                             <div class="space-y-4">
                                 <div>
                                     <div class="flex justify-between items-center mb-1">
                                         <span class="text-sm font-medium text-slate-300">Biology</span>
                                         <span class="text-sm font-bold text-slate-400">85%</span>
                                     </div>
                                     <div class="w-full bg-slate-800 h-2 rounded-full"><div class="bg-emerald-500 w-[85%] h-2 rounded-full shadow-[0_0_10px_rgba(16,185,129,0.4)]"></div></div>
                                 </div>
                                  <div>
                                     <div class="flex justify-between items-center mb-1">
                                         <span class="text-sm font-medium text-slate-300">Physics</span>
                                         <span class="text-sm font-bold text-slate-400">45%</span>
                                     </div>
                                     <div class="w-full bg-slate-800 h-2 rounded-full"><div class="bg-amber-500 w-[45%] h-2 rounded-full shadow-[0_0_10px_rgba(245,158,11,0.4)]"></div></div>
                                 </div>
                                  <div>
                                     <div class="flex justify-between items-center mb-1">
                                         <span class="text-sm font-medium text-slate-300">Chemistry</span>
                                         <span class="text-sm font-bold text-slate-400">70%</span>
                                     </div>
                                     <div class="w-full bg-slate-800 h-2 rounded-full"><div class="bg-purple-500 w-[70%] h-2 rounded-full shadow-[0_0_10px_rgba(168,85,247,0.4)]"></div></div>
                                 </div>
                             </div>
                        </div>
                         <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6">
                            <h3 class="text-lg font-bold text-slate-200 mb-6">AI Priority Action Feed</h3>
                            <div class="space-y-3">
                                <div class="bg-slate-800/30 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between hover:border-slate-600 transition-colors">
                                    <p class="text-sm font-medium text-slate-300">🔴 2 Critical mistakes require your attention in <span class="font-semibold">Physics</span>.</p>
                                    <button id="btn-resolve-mistakes" class="text-xs font-bold tracking-wide px-4 py-1.5 rounded-lg border transition-all bg-red-500/10 text-red-400 border-red-500/20 hover:bg-red-500 hover:text-white">Resolve</button>
                                </div>
                                <div class="bg-slate-800/30 border border-slate-700/50 rounded-xl p-4 flex items-center justify-between hover:border-slate-600 transition-colors">
                                    <p class="text-sm font-medium text-slate-300">🟠 <span class="font-semibold">Mitochondria</span> retention has dropped below 60%.</p>
                                    <button id="btn-revise-retention" class="text-xs font-bold tracking-wide px-4 py-1.5 rounded-lg border transition-all bg-purple-500/10 text-purple-400 border-purple-500/20 hover:bg-purple-600 hover:text-white">Revise</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- View 0: Smart Revision Engine -->
            <div id="smart-revision-view" class="hidden">
                <div class="max-w-7xl mx-auto">
                    <div class="mb-8">
                        <h1 class="text-xl font-medium text-[#f3f3f4] tracking-tight">Smart Revision Engine</h1>
                        <p class="mt-1 text-base text-[#9aa0a6]">Track your memory decay and optimize revision time.</p>
                    </div>

                    <div class="space-y-6">
                        <!-- Card 1: Mitochondria (Decaying Memory) -->
                        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-purple-500/50 hover:shadow-purple-900/20">
                            <p class="text-xs font-bold tracking-widest text-slate-500 uppercase mb-1">Class 9 Science: Fundamental Unit of Life</p>
                            <div class="flex items-center">
                                <h3 class="text-xl font-bold text-slate-200">Mitochondria</h3>
                                <span class="ml-4 text-xs bg-red-500/10 text-red-400 border border-red-500/20 px-3 py-1 rounded-full animate-pulse uppercase tracking-wider font-bold align-middle">🔴 Priority Action</span>
                            </div>

                            <div class="mt-6">
                                <label class="text-sm font-medium text-slate-300">Memory Health: 58%</label>
                                <div class="w-full bg-slate-800 h-2 rounded-full mt-2">
                                    <div class="bg-amber-500 w-[58%] h-2 rounded-full shadow-[0_0_10px_rgba(245,158,11,0.5)]"></div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 mt-6 gap-4">
                                <div class="flex items-center gap-2 text-sm text-slate-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Last Studied: <span class="font-semibold text-slate-300">4 Days Ago</span>
                                </div>
                                <div class="flex items-center gap-2 text-sm text-slate-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Past Score: <span class="font-semibold text-slate-300">16/20</span>
                                </div>
                                <div class="flex items-center gap-2 text-sm text-slate-400">
                                     <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                    Weakest Concept: <span class="font-semibold text-slate-300">ATP Generation</span>
                                </div>
                            </div>
                            
                            <div class="bg-purple-900/10 border border-purple-500/20 p-4 rounded-xl mt-6">
                                <p class="text-sm text-purple-300/90"><strong>AI Recommendation:</strong> Your memory retention is decaying. A 3-minute targeted revision will restore your memory to 95%.</p>
                            </div>

                            <button id="launch-revision-btn" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 rounded-lg mt-6 transition-all">
                                Launch Targeted Revision (Focus: ATP)
                            </button>
                        </div>

                        <!-- Card 2: Acceleration (Healthy Memory) -->
                        <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-green-500/50 hover:shadow-green-900/20">
                           <p class="text-xs font-bold tracking-widest text-slate-500 uppercase mb-1">Class 9 Physics: Kinematics</p>
                            <div class="flex items-center">
                                <h3 class="text-xl font-bold text-slate-200">Acceleration</h3>
                                <span class="ml-4 text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-3 py-1 rounded-full uppercase tracking-wider font-bold align-middle">🟢 Mastered</span>
                            </div>

                            <div class="mt-6">
                                <label class="text-sm font-medium text-slate-300">Memory Health: 94%</label>
                                <div class="w-full bg-slate-800 h-2 rounded-full mt-2">
                                    <div class="bg-green-500 w-[94%] h-2 rounded-full shadow-[0_0_10px_rgba(34,197,94,0.5)]"></div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 mt-6 gap-4">
                                <div class="flex items-center gap-2 text-sm text-slate-400">
                                     <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Last Studied: <span class="font-semibold text-slate-300">1 Day Ago</span>
                                </div>
                                <div class="flex items-center gap-2 text-sm text-slate-400">
                                     <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Past Score: <span class="font-semibold text-slate-300">19/20</span>
                                </div>
                                <div class="flex items-center gap-2 text-sm text-slate-400">
                                     <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                    Confidence: <span class="font-semibold text-slate-300">High</span>
                                </div>
                            </div>
                            
                            <div class="bg-green-900/10 border border-green-500/20 p-4 rounded-xl mt-6 text-slate-300 text-sm">
                                <p><strong>AI Recommendation:</strong> Memory is strong. No action needed right now. Focus on your weaker topics.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- View X: Mistake Database -->
            <div id="mistake-database-view" class="hidden">
                <div class="max-w-7xl mx-auto">
                    <div class="mb-8">
                        <h1 class="text-xl font-medium text-[#f3f3f4] tracking-tight">Personal Mistake Database</h1>
                        <p class="mt-1 text-base text-[#9aa0a6]">AI-tracked pattern analysis of your recurring errors.</p>
                    </div>

                    <!-- Tabs -->
                    <div class="flex gap-4 mb-6 border-b border-slate-800 pb-2">
                        <button id="tab-personal-mistakes" class="px-4 py-2 text-sm font-semibold rounded-lg bg-slate-800 text-white transition-colors">My Personal Mistakes</button>
                        <button id="tab-common-mistakes" class="px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-slate-200 transition-colors">Common Student Mistakes</button>
                    </div>

                    <!-- Personal Mistakes Content -->
                    <div id="personal-mistakes-content">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 mt-4">
                        <div class="bg-slate-800/30 border border-slate-700/50 rounded-xl p-4">
                            <p class="text-xs text-slate-400">Total Errors Tracked</p>
                            <p class="text-2xl text-slate-200 font-bold">142</p>
                        </div>
                        <div class="bg-slate-800/30 border border-slate-700/50 rounded-xl p-4">
                            <p class="text-xs text-slate-400">Biggest Weakness</p>
                            <p class="text-lg text-slate-200 font-bold mt-1">Class 9 Biology</p>
                        </div>
                        <div class="bg-slate-800/30 border border-slate-700/50 rounded-xl p-4">
                            <p class="text-xs text-slate-400">Mistakes Resolved</p>
                            <p class="text-2xl text-green-400 font-bold">28</p>
                        </div>
                    </div>

                    <button id="btn-generate-remedial" class="mb-6 bg-red-600 hover:bg-red-500 text-white font-semibold py-2 px-6 rounded-xl transition-all shadow-[0_0_15px_rgba(220,38,38,0.3)]">Generate Remedial Quiz</button>
                    
                    <div class="flex flex-col md:flex-row gap-3 mb-6">
                        <input type="text" placeholder="Search mistakes by keyword..." class="flex-1 bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-slate-300 focus:outline-none focus:border-purple-500 transition-colors" />
                        <select id="subject-filter" class="bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-slate-300 focus:outline-none focus:border-purple-500">
                            <option>All Subjects</option>
                            <option>Biology</option>
                            <option>Physics</option>
                        </select>
                        <select class="bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-slate-300 focus:outline-none focus:border-purple-500">
                            <option>Highest Frequency</option>
                            <option>Recent First</option>
                        </select>
                    </div>

                    <div id="mistake-cards-container" class="space-y-4">
                         <!-- Card 1 (Critical Priority) -->
                        <div data-subject="Biology" class="bg-slate-900/50 border border-red-500/30 rounded-2xl p-5 hover:-translate-y-1 hover:shadow-lg hover:border-red-500/50 transition-all duration-300">
                            <div class="flex justify-between items-center">
                                <span class="bg-red-500/10 text-red-400 px-2 py-1 rounded text-xs uppercase tracking-wide border border-red-500/20 font-semibold">Missing Keyword</span>
                                <span class="text-red-400 font-bold text-sm">Repeated 6 Times</span>
                            </div>
                            <p class="text-slate-300 mt-3 font-medium">Forgot to include 'ATP' (Adenosine Triphosphate) when explaining energy currency.</p>
                            <p class="text-slate-500 text-xs mt-2">Topic: Class 9 Biology - Mitochondria</p>
                            <div class="mt-4 pt-4 border-t border-slate-700/50 flex gap-4">
                                <button class="text-xs font-medium text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg> 
                                    View Original Question
                                </button>
                                <button class="text-xs font-medium text-slate-400 hover:text-green-400 transition-colors flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 
                                    Mark as Resolved
                                </button>
                            </div>
                        </div>
                        <!-- Card 2 (Warning Priority) -->
                        <div data-subject="Biology" class="bg-slate-900/50 border border-amber-500/30 rounded-2xl p-5 hover:-translate-y-1 hover:shadow-lg hover:border-amber-500/50 transition-all duration-300">
                           <div class="flex justify-between items-center">
                                <span class="bg-amber-500/10 text-amber-400 px-2 py-1 rounded text-xs uppercase tracking-wide border border-amber-500/20 font-semibold">Conceptual Mix-up</span>
                                <span class="text-amber-400 font-bold text-sm">Repeated 3 Times</span>
                            </div>
                            <p class="text-slate-300 mt-3 font-medium">Confused the folded inner membrane (cristae) with the porous outer membrane.</p>
                            <p class="text-slate-500 text-xs mt-2">Topic: Class 9 Biology - Mitochondria</p>
                             <div class="mt-4 pt-4 border-t border-slate-700/50 flex gap-4">
                                <button class="text-xs font-medium text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg> 
                                    View Original Question
                                </button>
                                <button class="text-xs font-medium text-slate-400 hover:text-green-400 transition-colors flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 
                                    Mark as Resolved
                                </button>
                            </div>
                        </div>
                    </div>
                    </div> <!-- End of personal mistakes content -->
                    
                    <!-- Common Mistakes Content -->
                    <div id="common-mistakes-content" class="hidden">
                        <div class="flex flex-wrap gap-3 mb-6 mt-4">
