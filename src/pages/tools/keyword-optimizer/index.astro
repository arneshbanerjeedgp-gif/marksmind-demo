                        { label: 'Ingestion', children: ['Document Parsing', 'Chunking Strategies', 'Tokenization', 'Data Cleaning', 'PDF Extraction', 'HTML Scraping', 'OCR Integration'] },
                        { label: 'Vector Storage', children: ['Vector Databases', 'Embeddings Generation', 'Index Management', 'Metadata Filtering', 'HNSW Algorithm', 'High Dimensionality', 'ANN Search'] },
                        { label: 'Retrieval', children: ['Semantic Search', 'Cosine Similarity', 'Hybrid Search', 'Keyword Matching', 'Re-ranking', 'Context Window Limits', 'Cross-Encoders'] },
                        { label: 'Generation', children: ['Prompt Augmentation', 'Hallucination Reduction', 'Few-Shot Prompting', 'Instruction Tuning', 'Response Formatting', 'Source Citation', 'Grounded Generation'] }
                    ]
                },
                'IKS': {
                    center: 'Indian Knowledge Systems',
                    branches: [
                        { label: 'Agriculture', children: ['Organic Farming', 'Crop Rotation', 'Panchang Timing', 'Natural Pest Control', 'Seed Preservation', 'Mixed Cropping', 'Soil Health'] },
                        { label: 'Water Management', children: ['Rainwater Harvesting', 'Stepwells (Baolis)', 'Johads', 'Check Dams', 'Aquifer Recharge', 'Canal Irrigation', 'Terrace Farming'] },
                        { label: 'Eco-Architecture', children: ['Terracotta Cooling', 'Courtyard Planning', 'Sun-Path Alignment', 'Mud & Bamboo Walls', 'Natural Ventilation', 'Lime Mortar', 'Vastu Principles'] },
                        { label: 'Holistic Health', children: ['Ayurveda', 'Herbal Medicine', 'Dietary Balance', 'Yoga & Asanas', 'Seasonal Routines', 'Mind-Body Harmony', 'Immunity Boosting'] }
                    ]
                },
                'Fractional Distillation': {
                    center: 'Fractional Distillation',
                    branches: [
                        { label: 'Conditions', children: ['Miscible Liquids', 'BP Diff < 25K', 'Homogeneous Mixture', 'Liquid Phase', 'Known Boiling Points', 'Multiple Components', 'Close BP Range'] },
                        { label: 'Apparatus', children: ['Distillation Flask', 'Fractionating Column', 'Glass Beads', 'Condenser', 'Thermometer', 'Collection Flask', 'Bunsen Burner'] },
                        { label: 'Applications', children: ['Separating Air Gases', 'Petroleum Refining', 'Ethanol Purification', 'Chemical Industry', 'Perfume Making', 'Pharmaceutical Prod.', 'Crude Oil Fractions'] },
                        { label: 'Process Steps', children: ['Heating Mixture', 'Vaporization', 'Rising Through Column', 'Repeated Condensation', 'Fraction Collection', 'Temp. Monitoring', 'Sequential Separation'] }
                    ]
                }
            };

            const nodeColors = [
                { bg: '#7c3aed', border: '#8b5cf6', text: '#f3f3f4', leafBg: 'rgba(124, 58, 237, 0.15)', leafText: '#ddd6fe' },  // purple
                { bg: '#0ea5e9', border: '#38bdf8', text: '#f3f3f4', leafBg: 'rgba(14, 165, 233, 0.15)', leafText: '#bae6fd' },  // sky
                { bg: '#10b981', border: '#34d399', text: '#f3f3f4', leafBg: 'rgba(16, 185, 129, 0.15)', leafText: '#a7f3d0' },  // emerald
                { bg: '#f59e0b', border: '#fbbf24', text: '#1a1a1a', leafBg: 'rgba(245, 158, 11, 0.15)', leafText: '#fde68a' },  // amber
                { bg: '#f43f5e', border: '#fb7185', text: '#f3f3f4', leafBg: 'rgba(244, 63, 94, 0.15)', leafText: '#fecdd3' }   // rose
            ];

            const renderMindMap = (topic) => {
                const data = mindmapData[topic];
                if (!data) return;
                const centerLabel = data.center;
                const branches = data.branches;
                mindmapSvg.innerHTML = '';

                const cx = 500, cy = 300;
                const branchRadius = 260;
                const leafRadius = 180;
                const angleStep = (2 * Math.PI) / branches.length;
                const startAngle = -Math.PI / 2;

                const transformGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                transformGroup.id = 'mindmap-transform-group';
                transformGroup.setAttribute('transform', `translate(${transformState.x}, ${transformState.y}) scale(${transformState.scale})`);

                // Defs for glow filters
                const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
                defs.innerHTML = `
                    <filter id="glow-purple" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="6" result="blur"/>
                        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                    </filter>
                    <filter id="glow-soft" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="3" result="blur"/>
                        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                    </filter>
                `;
                transformGroup.appendChild(defs);

                let animDelay = 0;

                // Draw branches
                branches.forEach((branch, i) => {
                    const angle = startAngle + i * angleStep;
                    const bx = cx + branchRadius * Math.cos(angle);
                    const by = cy + branchRadius * Math.sin(angle);
                    const color = nodeColors[i % nodeColors.length];

                    // Line: center -> branch
                    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                    line.setAttribute('x1', cx); line.setAttribute('y1', cy);
                    line.setAttribute('x2', bx); line.setAttribute('y2', by);
                    line.setAttribute('stroke', color.border);
                    line.setAttribute('stroke-width', '2.5');
                    line.setAttribute('stroke-opacity', '0.35');
                    line.style.opacity = '0';
                    line.style.animation = `mmFadeIn 0.4s ease ${animDelay}s forwards`;
                    transformGroup.appendChild(line);

                    // Branch node
                    const branchGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                    branchGroup.style.opacity = '0';
                    branchGroup.style.animation = `mmFadeIn 0.4s ease ${animDelay + 0.15}s forwards`;
                    branchGroup.style.cursor = 'default';

                    const branchTextLen = branch.label.length * 8 + 36;
                    const branchRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                    branchRect.setAttribute('x', bx - branchTextLen / 2);
                    branchRect.setAttribute('y', by - 18);
                    branchRect.setAttribute('width', branchTextLen);
                    branchRect.setAttribute('height', 36);
                    branchRect.setAttribute('rx', 18);
                    branchRect.setAttribute('fill', color.bg);
                    branchRect.setAttribute('stroke', color.border);
                    branchRect.setAttribute('stroke-width', '1.5');
                    branchRect.setAttribute('filter', 'url(#glow-soft)');
                    branchGroup.appendChild(branchRect);

                    const branchText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                    branchText.setAttribute('x', bx);
                    branchText.setAttribute('y', by + 5);
                    branchText.setAttribute('text-anchor', 'middle');
                    branchText.setAttribute('fill', color.text);
                    branchText.setAttribute('font-size', '13');
                    branchText.setAttribute('font-weight', '600');
                    branchText.setAttribute('font-family', 'Plus Jakarta Sans, sans-serif');
                    branchText.textContent = branch.label;
                    branchGroup.appendChild(branchText);

                    transformGroup.appendChild(branchGroup);

                    // Always Render Sub-branches
                    const leaves = branch.children;
                    const arcSpread = Math.PI * 0.9; // 162 degrees spread
                    const baseLeafAngle = angle - (arcSpread / 2);
                    const leafAngleSpread = leaves.length > 1 ? arcSpread / (leaves.length - 1) : 0;

                    leaves.forEach((leaf, j) => {
                        const la = baseLeafAngle + j * leafAngleSpread;
                        const lx = bx + leafRadius * Math.cos(la);
                        const ly = by + leafRadius * Math.sin(la);

                        // Line: branch -> leaf
                        const leafLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                        leafLine.setAttribute('x1', bx); leafLine.setAttribute('y1', by);
                        leafLine.setAttribute('x2', lx); leafLine.setAttribute('y2', ly);
                        leafLine.setAttribute('stroke', color.border);
                        leafLine.setAttribute('stroke-width', '1.5');
                        leafLine.setAttribute('stroke-opacity', '0.4');
                        leafLine.setAttribute('stroke-dasharray', '4 3');
                        leafLine.style.opacity = '0';
                        leafLine.style.animation = `mmFadeIn 0.2s ease ${j * 0.04}s forwards`;
                        transformGroup.appendChild(leafLine);

                        // Leaf node
                        const leafGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                        leafGroup.style.opacity = '0';
                        leafGroup.style.animation = `mmFadeIn 0.2s ease ${0.1 + j * 0.04}s forwards`;
                        leafGroup.style.cursor = 'default';

                        const leafTextLen = leaf.length * 7 + 28;
                        const leafRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                        leafRect.setAttribute('x', lx - leafTextLen / 2);
                        leafRect.setAttribute('y', ly - 14);
                        leafRect.setAttribute('width', leafTextLen);
                        leafRect.setAttribute('height', 28);
                        leafRect.setAttribute('rx', 14);
                        leafRect.setAttribute('fill', color.leafBg);
                        leafRect.setAttribute('stroke', color.border);
                        leafRect.setAttribute('stroke-width', '1');
                        leafGroup.appendChild(leafRect);

                        const leafText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                        leafText.setAttribute('x', lx);
                        leafText.setAttribute('y', ly + 4);
                        leafText.setAttribute('text-anchor', 'middle');
                        leafText.setAttribute('fill', color.leafText);
                        leafText.setAttribute('font-size', '11');
                        leafText.setAttribute('font-weight', '500');
                        leafText.setAttribute('font-family', 'Plus Jakarta Sans, sans-serif');
                        leafText.textContent = leaf;
                        leafGroup.appendChild(leafText);

                        // Hover interaction
                        leafGroup.addEventListener('mouseenter', () => {
                            leafRect.setAttribute('stroke-width', '2');
                            leafRect.setAttribute('fill', color.bg);
                            leafText.setAttribute('fill', color.text);
                        });
                        leafGroup.addEventListener('mouseleave', () => {
                            leafRect.setAttribute('stroke-width', '1');
                            leafRect.setAttribute('fill', color.leafBg);
                            leafText.setAttribute('fill', color.leafText);
                        });

                        transformGroup.appendChild(leafGroup);
                    });

                    animDelay += 0.25;
                });

                // Center node (rendered last so it's on top)
                const centerGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
                centerGroup.style.opacity = '0';
                centerGroup.style.animation = 'mmFadeIn 0.5s ease 0s forwards';

                const centerCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                centerCircle.setAttribute('cx', cx);
                centerCircle.setAttribute('cy', cy);
                centerCircle.setAttribute('r', 56);
                centerCircle.setAttribute('fill', '#7c3aed');
                centerCircle.setAttribute('stroke', '#a78bfa');
                centerCircle.setAttribute('stroke-width', '2.5');
                centerCircle.setAttribute('filter', 'url(#glow-purple)');
                centerGroup.appendChild(centerCircle);

                // Multi-line center label for long text
                const words = centerLabel.split(' ');
                let lines = [];
                let currentLine = '';
                words.forEach(w => {
                    if ((currentLine + ' ' + w).trim().length > 16) {
                        if (currentLine) lines.push(currentLine.trim());
                        currentLine = w;
                    } else {
                        currentLine = (currentLine + ' ' + w).trim();
                    }
                });
                if (currentLine) lines.push(currentLine.trim());

                const lineHeight = 17;
                const startY = cy - ((lines.length - 1) * lineHeight) / 2 + 5;
                lines.forEach((ln, idx) => {
                    const centerText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                    centerText.setAttribute('x', cx);
                    centerText.setAttribute('y', startY + idx * lineHeight);
                    centerText.setAttribute('text-anchor', 'middle');
                    centerText.setAttribute('fill', '#f3f3f4');
                    centerText.setAttribute('font-size', '13');
                    centerText.setAttribute('font-weight', '700');
                    centerText.setAttribute('font-family', 'Plus Jakarta Sans, sans-serif');
                    centerText.textContent = ln;
                    centerGroup.appendChild(centerText);
                });

                transformGroup.appendChild(centerGroup);
                mindmapSvg.appendChild(transformGroup);
            };

            // Shared generation trigger
            const triggerMindMap = (topic) => {
                mindmapEmpty.classList.add('hidden');
                mindmapSvg.classList.add('hidden');
                mindmapLoading.classList.remove('hidden');

                // reset pan/zoom state and expanded branches on new topic
                transformState = { x: 0, y: 0, scale: 1 };
                expandedBranches = {};

                const loadingSteps = [
                    'Analyzing concept structure...',
                    'Extracting NCERT relationships...',
                    'Building node hierarchy...',
                    'Rendering interactive map...'
                ];
                let step = 0;
                const loadingInterval = setInterval(() => {
                    step++;
                    if (step < loadingSteps.length) {
                        mindmapLoadingText.textContent = loadingSteps[step];
                    }
                }, 500);

                setTimeout(() => {
                    clearInterval(loadingInterval);
                    mindmapLoading.classList.add('hidden');
                    mindmapSvg.classList.remove('hidden');
                    renderMindMap(topic);
                }, 2200);
            };

            // Set active card styling
            const setActiveCard = (activeTopic) => {
                mmSandboxCards.forEach(card => {
                    if (card.getAttribute('data-topic') === activeTopic) {
                        card.classList.remove('bg-slate-900/40', 'border-slate-800');
                        card.classList.add('bg-purple-500/10', 'border-purple-500/40', 'shadow-lg', 'shadow-purple-900/20');
                    } else {
                        card.classList.remove('bg-purple-500/10', 'border-purple-500/40', 'shadow-lg', 'shadow-purple-900/20');
                        card.classList.add('bg-slate-900/40', 'border-slate-800');
                    }
                });
            };

            // Sandbox card click handler
            window.mmSandbox = (topic) => {
                setActiveCard(topic);
                triggerMindMap(topic);
            };

            // --- Mistake Database JS Logic ---
            const tabPersonal = document.getElementById('tab-personal-mistakes');
            const tabCommon = document.getElementById('tab-common-mistakes');
            const contentPersonal = document.getElementById('personal-mistakes-content');
            const contentCommon = document.getElementById('common-mistakes-content');

            if (tabPersonal && tabCommon) {
                tabPersonal.addEventListener('click', () => {
                    tabPersonal.className = "px-4 py-2 text-sm font-semibold rounded-lg bg-slate-800 text-white transition-colors";
                    tabCommon.className = "px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-slate-200 transition-colors";
                    contentPersonal.classList.remove('hidden');
                    contentCommon.classList.add('hidden');
                });
                tabCommon.addEventListener('click', () => {
                    tabCommon.className = "px-4 py-2 text-sm font-semibold rounded-lg bg-slate-800 text-white transition-colors";
                    tabPersonal.className = "px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-slate-200 transition-colors";
                    contentCommon.classList.remove('hidden');
                    contentPersonal.classList.add('hidden');
                });
            }

            const commonMistakesData = [
                { subject: "Biology", topic: "Mitochondria", issue: "Confusing the inner membrane (cristae) with the outer membrane.", freq: "High (68% of students)" },
                { subject: "Physics", topic: "Acceleration", issue: "Forgetting that acceleration is a vector quantity and requires a direction.", freq: "Very High (75% of students)" },
                { subject: "AI", topic: "RAG AI", issue: "Misunderstanding the difference between Context Retrieval and Document Generation.", freq: "Medium (45% of students)" },
                { subject: "IKS Sustainability", topic: "Traditional Water Management", issue: "Confusing the purpose of ancient Stepwells (Baolis) with modern hydro-dams.", freq: "High (62% of students)" },
                { subject: "Chemistry", topic: "Fractional Distillation", issue: "Confusing fractional distillation with simple distillation — forgetting the fractionating column requirement.", freq: "High (70% of students)" }
            ];

            const cmContainer = document.getElementById('common-mistakes-container');
            const renderCommonMistakes = (filterSubject = 'All') => {
                if(!cmContainer) return;
                cmContainer.innerHTML = '';
                const filtered = commonMistakesData.filter(m => filterSubject === 'All' || m.subject === filterSubject || filterSubject === 'All Subjects');
                
                filtered.forEach(m => {
                    const card = document.createElement('div');
                    card.className = "bg-slate-900/50 border border-amber-500/30 rounded-2xl p-5 hover:-translate-y-1 hover:shadow-lg hover:border-amber-500/50 transition-all duration-300";
                    card.innerHTML = `
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="bg-amber-500/10 text-amber-400 px-2 py-1 rounded text-xs uppercase tracking-wide border border-amber-500/20 font-semibold">${m.subject} - ${m.topic}</span>
                                <p class="text-slate-300 mt-3 font-medium">${m.issue}</p>
                            </div>
                            <span class="text-amber-400 font-bold text-sm bg-amber-500/10 px-3 py-1 rounded-full whitespace-nowrap">Freq: ${m.freq}</span>
                        </div>
                        <div class="mt-4 pt-4 border-t border-slate-700/50 flex gap-4">
                            <button onclick="takeRemedialQuiz('${m.topic}')" class="text-sm font-bold text-white bg-purple-600 hover:bg-purple-700 px-4 py-2 rounded-lg transition-colors flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Take Quiz
                            </button>
                        </div>
                    `;
                    cmContainer.appendChild(card);
                });
            };

            const cmFilters = document.querySelectorAll('.cm-filter-btn');
            cmFilters.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    cmFilters.forEach(b => {
                        b.className = "cm-filter-btn px-5 py-2 text-sm font-semibold rounded-full bg-slate-900/50 text-slate-400 hover:text-slate-200 border border-slate-800 hover:border-slate-700 transition-colors";
                    });
                    e.currentTarget.className = "cm-filter-btn px-5 py-2 text-sm font-semibold rounded-full bg-slate-800 text-white border border-slate-700 transition-colors";
                    renderCommonMistakes(e.currentTarget.dataset.filter);
                });
            });

            if(cmContainer) {
                renderCommonMistakes();
            }

            window.takeRemedialQuiz = (topic) => {
                let mappedTopic = topic;
                if (topic === "RAG AI") mappedTopic = "RAG";
                if (topic === "Traditional Water Management") mappedTopic = "IKS";
                if (topic === "Fractional Distillation") mappedTopic = "FractionalDistillation";

                state.topic = mappedTopic;
                state.mode = 'quiz';
                
                showView('quiz');
                
                startQuiz(5);
            };
        });

    </script>
    <style>
        .sandbox-btn.active-question-card {
            background-color: #1e1b2e !important;
            border-color: rgba(168, 85, 247, 0.8) !important;
            color: white !important;
            box-shadow: 0 0 12px rgba(168,85,247,0.15) !important;
        }
        @keyframes mmFadeIn {
            from { opacity: 0; transform: scale(0.85); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
</body>
</html>
