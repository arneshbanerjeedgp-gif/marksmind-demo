---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/landing/Navbar';
import Hero from '../components/landing/Hero';
import TrustTicker from '../components/landing/TrustTicker';
import TheProblem from '../components/landing/TheProblem';
import TheSolution from '../components/landing/TheSolution';
import FeatureCeda from '../components/landing/FeatureCeda';
import FeatureMemory from '../components/landing/FeatureMemory';
import FeatureMistakes from '../components/landing/FeatureMistakes';
import SubjectSandbox from '../components/landing/SubjectSandbox';
import Manifesto from '../components/landing/Manifesto';
import Personas from '../components/landing/Personas';
import BottomCTA from '../components/landing/BottomCTA';
import Footer from '../components/landing/Footer';
---

<BaseLayout 
    title="MarksMind AI | Precision Diagnostics"
    description="End the grading black box. We parse English, ignore bad grammar, and extract pure science."
>
    <style>
        :root {
            --bg-base: #0a0a0a;
        }
        body {
            background-color: var(--bg-base);
            color: #ffffff;
            font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
        ::selection {
            background-color: rgba(168, 85, 247, 0.3);
            color: white;
        }
    </style>

    <Navbar client:load />
    
    <main>
        <Hero client:load />
        <TrustTicker client:load />
        <TheProblem client:visible />
        <TheSolution client:visible />
        <FeatureCeda client:visible />
        <FeatureMemory client:visible />
        <FeatureMistakes client:visible />
        <SubjectSandbox client:load />
        <Manifesto client:visible />
        <Personas client:visible />
    </main>
    
    <BottomCTA client:visible />
    <Footer client:visible />
</BaseLayout>