---
import BaseLayout from '../layouts/BaseLayout.astro';
import { 
    BrainCircuit, Languages, Target, BookOpen, 
    ArrowRight, CheckCircle2, ChevronRight, Zap, 
    Database, RefreshCcw, FileX, Beaker, Dna, Code 
} from 'lucide-astro';
---

<BaseLayout 
    title="MarksMind AI | Precision Diagnostics for All"
    description="End the grading black box. We ignore bad grammar to evaluate your pure scientific concepts against NCERT standards."
>
    <style>
        :root {
            --bg-base: #121212;
            --bg-card: #1A1A1A;
            --purple-glow: rgba(168, 85, 247, 0.15);
        }

        body {
            background-color: var(--bg-base);
            color: #ffffff;
            font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        /* ── Scroll Reveal Utilities ── */
        .reveal-up {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-up.active {
            opacity: 1;
            transform: translateY(0);
        }
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }

        /* ── Glassmorphism & Gradients ── */
        .glass-nav {
            background: rgba(18, 18, 18, 0.6);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .glass-card {
            background: rgba(26, 26, 26, 0.6);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }

        .text-gradient-purple-pink {
            background: linear-gradient(135deg, #c084fc 0%, #ec4899 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .text-gradient-coral {
            background: linear-gradient(135deg, #fb923c 0%, #f43f5e 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ── Ticker Animation ── */
        @keyframes ticker {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .animate-ticker {
            display: flex;
            width: max-content;
            animation: ticker 25s linear infinite;
        }

        /* ── Floating Animation ── */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(1deg); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float-delayed {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(-1deg); }
        }
        .animate-float-delayed {
            animation: float-delayed 7s ease-in-out infinite;
            animation-delay: 1s;
        }

        /* ── Grid Glow Effects ── */
        .bento-card {
            transition: all 0.3s ease;
        }
        .bento-card:hover {
            border-color: rgba(168, 85, 247, 0.4);
            box-shadow: 0 0 40px var(--purple-glow);
            transform: translateY(-4px);
        }

        .radial-bg {
            background: radial-gradient(circle at center, rgba(107, 33, 168, 0.2) 0%, var(--bg-base) 70%);
        }
    </style>

    <!-- 1. Sticky Frosted Navigation -->
    <nav class="fixed top-0 w-full z-50 glass-nav transition-all duration-300">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <BrainCircuit class="w-8 h-8 text-purple-500" />
                <span class="text-xl font-bold tracking-tight text-white">MarksMind <span class="text-purple-400">AI</span></span>
            </div>
            <div class="flex items-center gap-6">
                <a href="/login?mode=signin" class="text-sm font-medium text-neutral-300 hover:text-white transition-colors">Login</a>
                <a href="/login?mode=signup" class="bg-purple-600 hover:bg-purple-500 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-all hover:shadow-[0_0_20px_rgba(147,51,234,0.4)]">
                    Get Started Free
                </a>
            </div>
        </div>
    </nav>

    <main class="pt-32">
        <!-- 2. Massive Hero Section -->
        <section class="relative max-w-7xl mx-auto px-6 pt-16 pb-24 lg:pt-24 lg:pb-32 overflow-hidden">
            <!-- Background Glow -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-purple-900/20 rounded-full blur-[120px] -z-10 pointer-events-none"></div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center relative z-10">
                <div class="reveal-up">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 mb-8">
                        <span class="flex h-2 w-2 rounded-full bg-purple-500 animate-pulse"></span>
                        <span class="text-xs font-semibold tracking-wide text-purple-300 uppercase">Precision Diagnostics Engine V2</span>
                    </div>
                    
                    <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6 text-white">
                        End the Grading <br/>
                        <span class="text-gradient-purple-pink">Black Box.</span>
                    </h1>
                    
                    <p class="text-lg lg:text-xl text-neutral-400 mb-10 leading-relaxed max-w-xl">
                        Traditional grading tells you what you scored. MarksMind AI tells you exactly why you lost marks. We ignore bad grammar to evaluate your pure scientific concepts against NCERT standards.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="/login?mode=signup" class="flex items-center justify-center gap-2 bg-white text-black px-8 py-4 rounded-full font-bold text-lg hover:bg-neutral-200 transition-all hover:scale-105 active:scale-95">
                            Start Free Diagnostic
                            <ArrowRight class="w-5 h-5" />
                        </a>
                        <a href="#how-it-works" class="flex items-center justify-center gap-2 bg-transparent border border-white/20 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-white/5 transition-all">
                            See How It Works
                        </a>
                    </div>
                </div>

                <!-- Hero Visual: Floating Glass Cards -->
                <div class="relative h-[500px] lg:h-[600px] hidden md:block reveal-up delay-200">
                    <!-- Main Student Answer Card -->
                    <div class="absolute right-10 top-1/2 -translate-y-1/2 w-[420px] glass-card rounded-2xl p-6 animate-float z-20">
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold shadow-lg">A</div>
                                <div>
                                    <p class="text-sm font-medium text-white">Student Answer</p>
                                    <p class="text-xs text-neutral-400">Class 10 Biology</p>
                                </div>
                            </div>
                            <div class="bg-red-500/10 text-red-400 px-2 py-1 rounded border border-red-500/20 text-xs font-mono font-bold">
                                grammar_errors: 4
                            </div>
                        </div>
                        <p class="text-neutral-300 text-sm leading-relaxed mb-6 font-mono bg-black/40 p-4 rounded-lg border border-white/5">
                            "Mitochondria is the power house of cell. It <span class="text-red-400 underline decoration-wavy decoration-red-500/50">make</span> energy in the form of ATP. It have double membrane."
                        </p>
                        
                        <div class="space-y-3">
                            <div class="flex items-center justify-between p-3 rounded-lg bg-green-500/10 border border-green-500/20">
                                <div class="flex items-center gap-2">
                                    <CheckCircle2 class="w-4 h-4 text-green-500" />
                                    <span class="text-sm text-green-100 font-medium">Concept Score</span>
                                </div>
                                <span class="text-green-400 font-bold">100%</span>
                            </div>
                            <div class="flex items-center justify-between p-3 rounded-lg bg-white/5 border border-white/10">
                                <div class="flex items-center gap-2">
                                    <Languages class="w-4 h-4 text-neutral-400" />
                                    <span class="text-sm text-neutral-300">Language Penalty</span>
                                </div>
                                <span class="text-white font-bold">0%</span>
                            </div>
                        </div>
                    </div>

                    <!-- AI Diagnostic Badge -->
                    <div class="absolute left-4 top-1/4 w-[240px] bg-[#1a1a1a] border border-purple-500/30 rounded-xl p-4 shadow-[0_0_30px_rgba(168,85,247,0.2)] animate-float-delayed z-30">
                        <div class="flex items-center gap-3 mb-2">
                            <Zap class="w-5 h-5 text-purple-400" />
                            <span class="text-sm font-bold text-white">CEDA Protocol</span>
                        </div>
                        <p class="text-xs text-purple-200/70">Concept extracted successfully despite grammatical syntax errors.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. Social Proof / Stats Ticker -->
        <section class="border-y border-white/5 bg-black/40 py-6 overflow-hidden">
            <div class="animate-ticker flex items-center gap-16 px-8">
                <!-- Ticker Content 1 -->
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <Target class="w-5 h-5 text-purple-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">100% NCERT Alignment</span>
                </div>
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <Languages class="w-5 h-5 text-pink-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">Zero Language Bias</span>
                </div>
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <BrainCircuit class="w-5 h-5 text-blue-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">Line-by-Line Diagnostics</span>
                </div>
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <Zap class="w-5 h-5 text-amber-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">₹0 Marginal Cost</span>
                </div>
                <!-- Ticker Content 2 (Duplicate for seamless loop) -->
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <Target class="w-5 h-5 text-purple-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">100% NCERT Alignment</span>
                </div>
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <Languages class="w-5 h-5 text-pink-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">Zero Language Bias</span>
                </div>
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <BrainCircuit class="w-5 h-5 text-blue-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">Line-by-Line Diagnostics</span>
                </div>
                <div class="flex items-center gap-4 text-neutral-400 whitespace-nowrap min-w-max">
                    <Zap class="w-5 h-5 text-amber-500" />
                    <span class="text-lg font-semibold tracking-wide uppercase">₹0 Marginal Cost</span>
                </div>
            </div>
        </section>

        <!-- 4. The Problem Statement (Visual Contrast) -->
        <section class="py-24 px-6 max-w-7xl mx-auto">
            <div class="text-center mb-16 reveal-up">
                <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">The Grading Reality</h2>
                <p class="text-neutral-400 text-lg">Stop settling for a red pen without an explanation.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 relative">
                <!-- Left: The Old Way -->
                <div class="bg-[#161616] border border-white/5 rounded-3xl p-8 lg:p-10 reveal-up relative overflow-hidden group">
                    <div class="absolute top-0 left-0 w-full h-1 bg-red-500/50"></div>
                    <h3 class="text-xl font-bold text-neutral-300 mb-6 flex items-center gap-2">
                        <FileX class="w-5 h-5 text-red-400" /> The Old Way
                    </h3>
                    
                    <div class="bg-white rounded p-6 shadow-inner relative transform -rotate-1 transition-transform group-hover:rotate-0">
                        <div class="absolute right-4 top-4 border-4 border-red-500 text-red-500 font-bold text-4xl rounded-full w-20 h-20 flex items-center justify-center opacity-80 transform rotate-12">
                            4/10
                        </div>
                        <p class="text-black font-serif text-lg leading-relaxed mt-12 mb-4 line-through decoration-red-500/30">
                            The heart is pumping blood to lungs and body. It have 4 rooms. Left side is oxygen blood. Right side is CO2 blood.
                        </p>
                        <p class="text-red-600 font-handwriting font-bold text-xl mt-8">
                            Poor grammar! Incomplete!
                        </p>
                    </div>
                </div>

                <!-- Right: The MarksMind Way -->
                <div class="bg-[#1a1a1a] border border-purple-500/30 rounded-3xl p-8 lg:p-10 reveal-up delay-200 relative overflow-hidden group shadow-[0_0_40px_rgba(168,85,247,0.1)]">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-purple-500 to-pink-500"></div>
                    <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                        <BrainCircuit class="w-5 h-5 text-purple-400" /> The MarksMind Way
                    </h3>
                    
                    <div class="space-y-4">
                        <div class="bg-[#121212] border border-white/10 rounded-xl p-5 border-l-4 border-l-green-500">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-bold text-green-400 uppercase tracking-wider">Concept Matched</span>
                                <span class="bg-green-500/20 text-green-400 text-xs px-2 py-0.5 rounded">+2 Marks</span>
                            </div>
                            <p class="text-sm text-neutral-300">"4 rooms" correctly maps to <strong class="text-white">4 chambers (2 atria, 2 ventricles)</strong>.</p>
                        </div>
                        
                        <div class="bg-[#121212] border border-white/10 rounded-xl p-5 border-l-4 border-l-green-500">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-bold text-green-400 uppercase tracking-wider">Concept Matched</span>
                                <span class="bg-green-500/20 text-green-400 text-xs px-2 py-0.5 rounded">+2 Marks</span>
                            </div>
                            <p class="text-sm text-neutral-300">Identified Double Circulation: <strong class="text-white">Oxygenated (Left) vs Deoxygenated (Right)</strong>.</p>
                        </div>

                        <div class="bg-purple-900/10 border border-purple-500/30 rounded-xl p-5 border-l-4 border-l-purple-500">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-bold text-purple-400 uppercase tracking-wider">Missing Keyword Gap</span>
                                <span class="bg-neutral-800 text-neutral-400 text-xs px-2 py-0.5 rounded">-1 Mark</span>
                            </div>
                            <p class="text-sm text-neutral-300">You forgot to mention the <strong class="text-white">valves</strong> (bicuspid/tricuspid) that prevent backflow of blood.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. Core Philosophy -->
        <section class="py-24 border-y border-white/5 bg-[#121212]">
            <div class="max-w-4xl mx-auto px-6 text-center reveal-up">
                <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight text-gradient-coral">
                    Elite level feedback shouldn't be a luxury.
                </h2>
                <p class="text-xl text-neutral-400 leading-relaxed">
                    Millions of brilliant minds lose marks not because they don't understand the science, but because they can't afford a private tutor to teach them the "art of writing" board answers. MarksMind AI is the great equalizer—a 24/7 private tutor in your pocket.
                </p>
            </div>
        </section>

        <!-- 6. Bento Box Features Grid -->
        <section class="py-24 px-6 max-w-7xl mx-auto">
            <div class="text-center mb-16 reveal-up">
                <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">The Intelligence Engine</h2>
                <p class="text-neutral-400">Everything you need to secure the last 5%.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Card 1 (Large) -->
                <div class="bento-card col-span-1 md:col-span-2 lg:col-span-2 bg-[#161618] border border-white/10 rounded-3xl p-8 reveal-up">
                    <Target class="w-10 h-10 text-purple-400 mb-6" />
                    <h3 class="text-2xl font-bold text-white mb-3">CEDA Protocol</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed mb-6">
                        Concept Extraction & Defect Analysis. Our proprietary engine reads through broken grammar and regional dialects to extract the raw scientific concepts you're trying to convey, grading you strictly on knowledge, not vocabulary.
                    </p>
                    <div class="bg-black/50 rounded-xl p-4 border border-white/5 font-mono text-xs text-neutral-500">
                        <span class="text-purple-400">Analysis:</span> { status: "Success", confidence: 0.98, concepts_found: ["momentum", "inertia"] }
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="bento-card col-span-1 bg-[#161618] border border-white/10 rounded-3xl p-8 reveal-up delay-100">
                    <Languages class="w-10 h-10 text-pink-400 mb-6" />
                    <h3 class="text-2xl font-bold text-white mb-3">The Language Bridge</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">
                        Write your initial thoughts in Hinglish. MarksMind translates and bridges your raw understanding into perfect, NCERT-compliant board-level English vocabulary automatically.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bento-card col-span-1 bg-[#161618] border border-white/10 rounded-3xl p-8 reveal-up delay-200">
                    <Database class="w-10 h-10 text-sky-400 mb-6" />
                    <h3 class="text-2xl font-bold text-white mb-3">Mistake Database</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">
                        Every error you make is logged. The AI identifies patterns in your logic gaps over time and surfaces your most frequent conceptual misunderstandings before the exam.
                    </p>
                </div>

                <!-- Card 4 (Large) -->
                <div class="bento-card col-span-1 md:col-span-2 bg-[#161618] border border-white/10 rounded-3xl p-8 reveal-up delay-300">
                    <RefreshCcw class="w-10 h-10 text-amber-400 mb-6" />
                    <h3 class="text-2xl font-bold text-white mb-3">Smart Revision Tracking</h3>
                    <p class="text-neutral-400 text-sm leading-relaxed">
                        Built on the science of spaced repetition. The system tracks your memory decay curve for every NCERT topic and alerts you exactly when a concept is about to be forgotten, optimizing your revision time.
                    </p>
                </div>
            </div>
        </section>

        <!-- 7. How It Works -->
        <section id="how-it-works" class="py-24 border-y border-white/5 bg-[#0a0a0a]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16 reveal-up">
                    <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">How It Works</h2>
                    <p class="text-neutral-400">From messy thoughts to board-perfect answers in seconds.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
                    <!-- Connecting line for desktop -->
                    <div class="hidden md:block absolute top-12 left-[16%] right-[16%] h-[2px] bg-gradient-to-r from-purple-500/20 via-purple-500/50 to-purple-500/20 z-0"></div>

                    <!-- Step 1 -->
                    <div class="relative z-10 flex flex-col items-center text-center reveal-up">
                        <div class="w-24 h-24 rounded-full bg-[#161618] border border-white/10 flex items-center justify-center text-2xl font-bold text-white mb-6 shadow-lg shadow-purple-900/20">
                            1
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Write Freely</h3>
                        <p class="text-neutral-400 text-sm">Don't stress over grammar. Write down your raw scientific understanding in broken English or Hinglish.</p>
                    </div>

                    <!-- Step 2 -->
                    <div class="relative z-10 flex flex-col items-center text-center reveal-up delay-100">
                        <div class="w-24 h-24 rounded-full bg-[#161618] border border-purple-500/50 flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(168,85,247,0.3)]">
                            <BrainCircuit class="w-10 h-10 text-purple-400" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">AI Concept Extraction</h3>
                        <p class="text-neutral-400 text-sm">The engine ignores the noise and extracts the pure academic concepts, cross-referencing them with NCERT marking schemes.</p>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative z-10 flex flex-col items-center text-center reveal-up delay-200">
                        <div class="w-24 h-24 rounded-full bg-[#161618] border border-white/10 flex items-center justify-center text-2xl font-bold text-white mb-6 shadow-lg shadow-green-900/20">
                            3
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Get Perfected Output</h3>
                        <p class="text-neutral-400 text-sm">Instantly see your missing keywords and get a rewritten, board-ready answer that secures full marks.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 8. Subject Sandbox Showcase -->
        <section class="py-24 px-6 max-w-7xl mx-auto overflow-hidden">
            <div class="mb-12 reveal-up">
                <h2 class="text-2xl md:text-3xl font-bold mb-4 text-white">Built for Hard Academics</h2>
                <p class="text-neutral-400">Test the engine right now across core science and tech subjects.</p>
            </div>

            <div class="flex flex-row items-center gap-4 overflow-x-auto no-scrollbar pb-6 reveal-up delay-100">
                <div class="bg-[#161618] border border-purple-500/40 rounded-2xl p-6 min-w-[280px] shrink-0 cursor-pointer hover:bg-[#1a1a1c] transition-colors group">
                    <div class="flex items-center gap-3 mb-4">
                        <Beaker class="w-6 h-6 text-rose-400 group-hover:scale-110 transition-transform" />
                        <span class="text-xs font-bold uppercase tracking-wider text-neutral-400">Chemistry</span>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">Fractional Distillation</h3>
                    <p class="text-xs text-neutral-500">Separation Techniques</p>
                </div>
                
                <div class="bg-[#161618] border border-white/10 rounded-2xl p-6 min-w-[280px] shrink-0 cursor-pointer hover:border-emerald-500/40 transition-colors group">
                    <div class="flex items-center gap-3 mb-4">
                        <Target class="w-6 h-6 text-emerald-400 group-hover:scale-110 transition-transform" />
                        <span class="text-xs font-bold uppercase tracking-wider text-neutral-400">Physics</span>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">Velocity & Acceleration</h3>
                    <p class="text-xs text-neutral-500">Kinematics</p>
                </div>

                <div class="bg-[#161618] border border-white/10 rounded-2xl p-6 min-w-[280px] shrink-0 cursor-pointer hover:border-purple-500/40 transition-colors group">
                    <div class="flex items-center gap-3 mb-4">
                        <Dna class="w-6 h-6 text-purple-400 group-hover:scale-110 transition-transform" />
                        <span class="text-xs font-bold uppercase tracking-wider text-neutral-400">Biology</span>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-1">Cellular Powerhouse</h3>
                    <p class="text-xs text-neutral-500">Mitochondria Structure</p>
                </div>

                <div class="bg-[#161618] border border-white/10 rounded-2xl p-6 min-w-[280px] shrink-0 cursor-pointer hover:border-sky-500/40 transition-colors group">
                    <div class="flex items-center gap-3 mb-4">
                        <Code class="w-6 h-6 text-sky-400 group-hover:scale-110 transition-transform" />
