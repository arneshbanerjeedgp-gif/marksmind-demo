---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/landing/Navbar';
import Hero from '../components/landing/Hero';
import StatsTicker from '../components/landing/StatsTicker';
import GradingReality from '../components/landing/GradingReality';
import Philosophy from '../components/landing/Philosophy';
import FeatureGrid from '../components/landing/FeatureGrid';
import HowItWorks from '../components/landing/HowItWorks';
import SubjectSandbox from '../components/landing/SubjectSandbox';
import Personas from '../components/landing/Personas';
import CTA from '../components/landing/CTA';
---

<BaseLayout 
    title="MarksMind AI | Precision Diagnostics for All"
    description="End the grading black box. We ignore bad grammar to evaluate your pure scientific concepts against NCERT standards."
>
    <style>
        :root {
            --bg-base: #121212;
        }
        body {
            background-color: var(--bg-base);
            color: #ffffff;
            font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
    </style>

    <Navbar client:load />
    
    <main>
        <Hero client:load />
        <StatsTicker client:load />
        <GradingReality client:visible />
        <Philosophy client:visible />
        <FeatureGrid client:visible />
        <HowItWorks client:visible />
        <SubjectSandbox client:load />
        <Personas client:visible />
    </main>
    
    <CTA client:visible />
</BaseLayout>