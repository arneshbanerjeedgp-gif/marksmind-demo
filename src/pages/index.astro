---
import '@fontsource/plus-jakarta-sans';
import { Sparkles, BrainCircuit, Languages, Target, BookOpen } from 'lucide-astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MarksMind AI — Grade the Science, Not the Grammar</title>
    <meta name="description" content="The first AI answer evaluator built for Indian students. Write in Bengali, Hindi, or Hinglish. We extract the concepts, ignore the typos, and bridge you to perfect board-level English.">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
        /* ── Design Tokens ── */
        :root {
            --mm-bg:        #0b0b0c;
            --mm-surface:   #161618;
            --mm-card:      #1A1A1A;
            --mm-border:    #2a2a2c;
            --mm-border-lt: #2e2e2e;
            --mm-text-1:    #f3f3f4;
            --mm-text-2:    #9aa0a6;
            --mm-text-3:    rgba(255,255,255,0.35);
            --mm-accent:    #8b5cf6;
            --mm-accent-hv: #7c3aed;
            --mm-accent-lt: #a78bfa;
            --mm-ease:      cubic-bezier(0.22, 1, 0.36, 1);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            background: var(--mm-bg);
            color: var(--mm-text-1);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* ── Scroll Reveal ── */
        .reveal {
            opacity: 0;
            transform: translateY(32px);
            transition: opacity 0.7s var(--mm-ease), transform 0.7s var(--mm-ease);
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .reveal-delay-1 { transition-delay: 0.1s; }
        .reveal-delay-2 { transition-delay: 0.2s; }
        .reveal-delay-3 { transition-delay: 0.3s; }
        .reveal-delay-4 { transition-delay: 0.4s; }

        /* ── Header ── */
        .lp-header {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 24px;
            background: rgba(11, 11, 12, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .lp-logo {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: var(--mm-text-1);
            text-decoration: none;
        }
        .lp-logo span { color: var(--mm-accent-lt); }
        .lp-header-actions { display: flex; align-items: center; gap: 8px; }
        .lp-btn-ghost {
            background: none; border: none;
            color: var(--mm-text-2);
            font-family: inherit; font-size: 14px; font-weight: 500;
            padding: 8px 16px; cursor: pointer;
            transition: color 0.2s ease;
            text-decoration: none;
        }
        .lp-btn-ghost:hover { color: var(--mm-text-1); }
        .lp-btn-primary {
            display: inline-flex; align-items: center;
            background: var(--mm-accent);
            color: #fff;
            font-family: inherit; font-size: 14px; font-weight: 600;
            padding: 9px 20px;
            border-radius: 9999px; border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .lp-btn-primary:hover {
            background: var(--mm-accent-hv);
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
        }

        /* ── Hero ── */
        .lp-hero {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 160px 24px 80px;
            max-width: 900px;
            margin: 0 auto;
        }
        .lp-hero-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 14px;
            border-radius: 9999px;
            background: rgba(139, 92, 246, 0.08);
            border: 1px solid rgba(139, 92, 246, 0.15);
            color: var(--mm-accent-lt);
            font-size: 12px; font-weight: 600;
            letter-spacing: 0.3px;
            margin-bottom: 28px;
        }
        .lp-hero h1 {
            font-size: clamp(36px, 7vw, 72px);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.08;
            margin-bottom: 24px;
            background: linear-gradient(135deg, #f3f3f4 30%, var(--mm-accent-lt) 70%, var(--mm-accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .lp-hero p {
            font-size: clamp(15px, 2vw, 18px);
            color: var(--mm-text-2);
            line-height: 1.65;
            max-width: 620px;
            margin-bottom: 40px;
        }
        .lp-hero-cta {
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--mm-accent);
            color: #fff;
            font-family: inherit; font-size: 16px; font-weight: 600;
            padding: 16px 32px;
            border-radius: 9999px; border: none;
            cursor: pointer;
            transition: all 0.25s ease;
            text-decoration: none;
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.25);
        }
        .lp-hero-cta:hover {
            background: var(--mm-accent-hv);
            box-shadow: 0 0 50px rgba(139, 92, 246, 0.4);
            transform: scale(1.03);
        }
        .lp-hero-cta:active { transform: scale(0.98); }

        /* ── Hero Mock-up ── */
        .lp-mockup-wrap {
            width: 100%;
            max-width: 560px;
            margin: 60px auto 0;
            perspective: 800px;
        }
        .lp-mockup {
            background: rgba(26, 26, 26, 0.7);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 20px;
            padding: 28px;
            backdrop-filter: blur(12px);
            transform: rotateX(4deg) rotateY(-2deg);
            box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 0 40px rgba(139,92,246,0.05);
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0%, 100% { transform: rotateX(4deg) rotateY(-2deg) translateY(0); }
            50%      { transform: rotateX(3deg) rotateY(-1deg) translateY(-8px); }
        }
        .lp-mock-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 20px;
        }
        .lp-mock-badge {
            font-size: 11px; font-weight: 700;
            letter-spacing: 0.8px; text-transform: uppercase;
            color: var(--mm-accent-lt);
        }
        .lp-mock-score {
            font-size: 22px; font-weight: 800;
            color: #22c55e;
            text-shadow: 0 0 12px rgba(34, 197, 94, 0.35);
        }
        .lp-mock-answer {
            background: var(--mm-surface);
            border: 1px solid var(--mm-border);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .lp-mock-answer-label {
            font-size: 10px; font-weight: 700;
            letter-spacing: 1px; text-transform: uppercase;
            color: var(--mm-text-3);
            margin-bottom: 8px;
        }
        .lp-mock-answer-text {
            font-size: 13px; color: var(--mm-text-2);
            line-height: 1.6; font-style: italic;
        }
        .lp-mock-ceda {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 16px;
            border-radius: 12px;
            background: rgba(139, 92, 246, 0.06);
            border: 1px solid rgba(139, 92, 246, 0.12);
        }
        .lp-mock-ceda-label { font-size: 12px; font-weight: 600; color: var(--mm-accent-lt); }
        .lp-mock-ceda-val {
            font-size: 20px; font-weight: 800; color: #22c55e;
            text-shadow: 0 0 10px rgba(34, 197, 94, 0.3);
        }

        /* ── Stats Banner ── */
        .lp-stats {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px;
            flex-wrap: wrap;
            padding: 48px 24px;
            border-top: 1px solid rgba(255,255,255,0.04);
            border-bottom: 1px solid rgba(255,255,255,0.04);
            max-width: 900px;
            margin: 0 auto;
        }
        .lp-stat { text-align: center; }
        .lp-stat-num {
            font-size: 28px; font-weight: 800;
            color: var(--mm-text-1);
            margin-bottom: 4px;
        }
        .lp-stat-label {
            font-size: 13px; color: var(--mm-text-2);
            font-weight: 500;
        }
        @media (max-width: 600px) {
            .lp-stats { gap: 24px; }
            .lp-stat-num { font-size: 22px; }
        }

        /* ── Bento Grid ── */
        .lp-bento-section {
            max-width: 960px;
            margin: 0 auto;
            padding: 80px 24px;
        }
        .lp-section-title {
            font-size: clamp(24px, 4vw, 36px);
            font-weight: 700;
            letter-spacing: -0.5px;
            text-align: center;
            margin-bottom: 12px;
        }
        .lp-section-sub {
            font-size: 15px;
            color: var(--mm-text-2);
            text-align: center;
            max-width: 500px;
            margin: 0 auto 48px;
            line-height: 1.6;
        }
        .lp-bento {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }
        .lp-bento-card {
            background: var(--mm-card);
            border: 1px solid var(--mm-border);
            border-radius: 20px;
            padding: 32px 28px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .lp-bento-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 20px;
            opacity: 0;
            background: radial-gradient(circle at 50% 0%, rgba(139,92,246,0.06), transparent 70%);
            transition: opacity 0.3s ease;
        }
        .lp-bento-card:hover {
            border-color: rgba(139,92,246,0.25);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.3), 0 0 20px rgba(139,92,246,0.06);
        }
        .lp-bento-card:hover::before { opacity: 1; }
        .lp-bento-card--lg { grid-column: span 2; }

        .lp-bento-icon {
            width: 44px; height: 44px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 12px;
            background: var(--mm-surface);
            border: 1px solid var(--mm-border);
            margin-bottom: 20px;
        }
        .lp-bento-icon svg { width: 20px; height: 20px; color: var(--mm-accent-lt); }
        .lp-bento-card h3 {
            font-size: 18px; font-weight: 700;
            color: var(--mm-text-1);
            margin-bottom: 8px;
            position: relative;
        }
        .lp-bento-card p {
            font-size: 14px;
            color: var(--mm-text-2);
            line-height: 1.6;
            position: relative;
        }

        @media (max-width: 640px) {
            .lp-bento { grid-template-columns: 1fr; }
            .lp-bento-card--lg { grid-column: span 1; }
        }

        /* ── Bottom CTA ── */
        .lp-bottom-cta {
            text-align: center;
            padding: 80px 24px 100px;
            max-width: 700px;
            margin: 0 auto;
        }
        .lp-bottom-cta h2 {
            font-size: clamp(24px, 4vw, 38px);
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: 24px;
            line-height: 1.2;
        }
        .lp-bottom-cta-btn {
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--mm-accent);
            color: #fff;
            font-family: inherit; font-size: 16px; font-weight: 600;
            padding: 16px 36px;
            border-radius: 9999px; border: none;
            cursor: pointer;
            transition: all 0.25s ease;
            text-decoration: none;
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);
            margin-bottom: 16px;
        }
        .lp-bottom-cta-btn:hover {
            background: var(--mm-accent-hv);
            box-shadow: 0 0 50px rgba(139, 92, 246, 0.35);
            transform: scale(1.03);
        }
        .lp-bottom-cta p {
            font-size: 14px;
            color: var(--mm-text-3);
        }

        /* ── Footer ── */
        .lp-footer {
            text-align: center;
            padding: 32px 24px;
            border-top: 1px solid rgba(255,255,255,0.04);
            font-size: 12px;
            color: var(--mm-text-3);
        }
    </style>
</head>
<body>

    <!-- ════════════  HEADER  ════════════ -->
    <header class="lp-header">
        <a href="/" class="lp-logo">Marks<span>Mind</span> AI</a>
        <div class="lp-header-actions">
            <a href="/login" class="lp-btn-ghost">Login</a>
            <a href="/login" class="lp-btn-primary">Sign Up</a>
        </div>
    </header>

    <!-- ════════════  HERO  ════════════ -->
    <section class="lp-hero">
        <div class="lp-hero-badge reveal">
            <Sparkles class="w-3.5 h-3.5" /> Built for Indian Students
        </div>

        <h1 class="reveal reveal-delay-1">Grade the Science, Not the Grammar.</h1>

        <p class="reveal reveal-delay-2">The first AI evaluator built for Indian students. Write in Bengali, Hindi, or Hinglish. We extract the concepts, ignore the typos, and bridge you to perfect board-level English.</p>

        <a href="/login" class="lp-hero-cta reveal reveal-delay-3">
            <Sparkles class="w-4 h-4" /> Analyze Your First Answer — Free
        </a>

        <!-- Glassmorphism Mock-up -->
        <div class="lp-mockup-wrap reveal reveal-delay-4">
            <div class="lp-mockup">
                <div class="lp-mock-header">
                    <span class="lp-mock-badge">CEDA Evaluator</span>
                    <span class="lp-mock-score">3 / 3</span>
                </div>
                <div class="lp-mock-answer">
                    <p class="lp-mock-answer-label">Student's Answer</p>
                    <p class="lp-mock-answer-text">"Photosynthasis is when plant use sunlite and CO2 to making food. chlorofil is help in this prosess. it happen in leaf and produce oxigen and glucos."</p>
                </div>
                <div class="lp-mock-ceda">
                    <span class="lp-mock-ceda-label">Language Bias Penalty</span>
                    <span class="lp-mock-ceda-val">0</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════════  STATS  ════════════ -->
    <section class="lp-stats">
        <div class="lp-stat reveal">
            <p class="lp-stat-num">94%</p>
            <p class="lp-stat-label">Teacher-Grade Agreement</p>
        </div>
        <div class="lp-stat reveal reveal-delay-1">
            <p class="lp-stat-num">&lt; ₹0.20</p>
            <p class="lp-stat-label">Per Evaluation</p>
        </div>
        <div class="lp-stat reveal reveal-delay-2">
            <p class="lp-stat-num">82 pages</p>
            <p class="lp-stat-label">Paper Saved / Student</p>
        </div>
    </section>

    <!-- ════════════  BENTO FEATURES  ════════════ -->
    <section class="lp-bento-section">
        <h2 class="lp-section-title reveal">Everything you need to score higher.</h2>
        <p class="lp-section-sub reveal reveal-delay-1">Powered by CEDA — our Concept Extraction & Diagnostic AI engine.</p>

        <div class="lp-bento">
            <!-- Card 1 — Large -->
            <div class="lp-bento-card lp-bento-card--lg reveal">
                <div class="lp-bento-icon"><BrainCircuit class="w-5 h-5" /></div>
                <h3>CEDA Engine</h3>
                <p>Zero language bias. Our AI reads past your grammar, spelling, and language mixing. It extracts the raw scientific concepts from your answer and grades you purely on knowledge — the way it should be.</p>
            </div>

            <!-- Card 2 — Medium -->
            <div class="lp-bento-card reveal reveal-delay-1">
                <div class="lp-bento-icon"><Languages class="w-5 h-5" /></div>
                <h3>The Language Bridge</h3>
                <p>Instantly translates your thoughts into perfect CBSE-standard English. See exactly how an examiner would write it.</p>
            </div>

            <!-- Card 3 — Medium -->
            <div class="lp-bento-card reveal reveal-delay-2">
                <div class="lp-bento-icon"><Target class="w-5 h-5" /></div>
                <h3>Mistake Database</h3>
                <p>AI tracks your exact conceptual gaps across every test. Know your blind spots before your examiner does.</p>
            </div>

            <!-- Card 4 — Large -->
            <div class="lp-bento-card lp-bento-card--lg reveal reveal-delay-3">
                <div class="lp-bento-icon"><BookOpen class="w-5 h-5" /></div>
                <h3>Smart Revision</h3>
                <p>Memory-decay tracking ensures you never forget a concept before exam day. CEDA identifies what you're about to forget and queues it for review at the perfect moment — backed by cognitive science.</p>
            </div>
        </div>
    </section>

    <!-- ════════════  BOTTOM CTA  ════════════ -->
    <section class="lp-bottom-cta">
        <h2 class="reveal">Ready to find out where your marks are actually going?</h2>
        <a href="/login" class="lp-bottom-cta-btn reveal reveal-delay-1">Start the Diagnostic Quiz</a>
        <p class="reveal reveal-delay-2">Join thousands of students studying smarter, not harder.</p>
    </section>

    <!-- ════════════  FOOTER  ════════════ -->
    <footer class="lp-footer">
        <p>&copy; 2025 MarksMind AI. All rights reserved.</p>
    </footer>

    <!-- ════════════  SCROLL REVEAL SCRIPT  ════════════ -->
    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>

</body>
</html>