---
/**
 * AuthForm.astro
 * ──────────────
 * Dual-view authentication card with Sign-Up (default) and Login.
 *
 * Dark theme · Tailwind CSS
 */
---

<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-[#121212]">
  <div
    id="auth-card"
    class="w-full max-w-md rounded-2xl border border-[#2e2e2e] bg-[#1c1c1c] px-8 py-10 shadow-2xl shadow-black/40"
  >

    <!-- SIGN UP VIEW (Default) -->
    <div id="signup-view" class="flex flex-col">
      <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold tracking-tight text-white">Sign Up</h1>
        <p class="mt-2 text-sm text-gray-400 leading-relaxed">
          Create notes in minutes. Free forever. No credit card required.
        </p>
      </div>

      <form id="signup-form" class="space-y-5" novalidate>
        <!-- Google OAuth -->
        <button
          type="button"
          class="google-auth-trigger relative z-10 flex w-full items-center justify-center rounded-lg border border-[#2e2e2e] bg-[#252525] px-4 py-3 text-sm font-medium text-white transition-all duration-200 hover:bg-[#2e2e2e] hover:border-[#3e3e3e] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/50 cursor-pointer"
        >
          <!-- Standard Google "G" icon -->
          <svg class="w-5 h-5 mr-3 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59a14.5 14.5 0 0 1 0-9.18l-7.98-6.19a24.1 24.1 0 0 0 0 21.56l7.98-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          Continue with Google
        </button>

        <!-- Divider -->
        <div class="relative flex items-center py-1">
          <div class="flex-grow border-t border-[#2e2e2e]"></div>
          <span class="mx-4 shrink-0 text-xs font-medium uppercase tracking-wider text-gray-500">or</span>
          <div class="flex-grow border-t border-[#2e2e2e]"></div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block mb-1.5 text-sm font-medium text-gray-300">Email</label>
            <input type="email" placeholder="you@example.com" required class="w-full rounded-lg border border-[#2e2e2e] bg-[#252525] px-4 py-3 text-sm text-white placeholder-gray-500 transition-all duration-200 focus:border-[#8b5cf6] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/30" />
          </div>
          <div>
            <label class="block mb-1.5 text-sm font-medium text-gray-300">Password</label>
            <input type="password" placeholder="••••••••" required class="w-full rounded-lg border border-[#2e2e2e] bg-[#252525] px-4 py-3 text-sm text-white placeholder-gray-500 transition-all duration-200 focus:border-[#8b5cf6] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/30" />
          </div>
        </div>
        <button type="submit" class="w-full rounded-lg bg-[#8b5cf6] px-4 py-3 text-sm font-semibold text-white transition-all duration-200 hover:bg-[#7c3aed] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/50 focus:ring-offset-2 focus:ring-offset-[#1c1c1c] cursor-pointer">
          Create an account
        </button>
      </form>
      
      <p class="mt-8 text-center text-sm text-gray-400">
        Already have an account?
        <button type="button" class="toggle-to-login font-medium text-[#8b5cf6] hover:text-[#a78bfa] transition-colors cursor-pointer">Login</button>
      </p>
    </div>

    <!-- LOGIN VIEW (Hidden) -->
    <div id="login-view" class="hidden flex flex-col">
      <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold tracking-tight text-white">Login</h1>
        <p class="mt-2 text-sm text-gray-400 leading-relaxed">
          Welcome back.
        </p>
      </div>

      <form id="login-form" class="space-y-5" novalidate>
        <!-- Google OAuth -->
        <button
          type="button"
          class="google-auth-trigger relative z-10 flex w-full items-center justify-center rounded-lg border border-[#2e2e2e] bg-[#252525] px-4 py-3 text-sm font-medium text-white transition-all duration-200 hover:bg-[#2e2e2e] hover:border-[#3e3e3e] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/50 cursor-pointer"
        >
          <!-- Standard Google "G" icon -->
          <svg class="w-5 h-5 mr-3 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59a14.5 14.5 0 0 1 0-9.18l-7.98-6.19a24.1 24.1 0 0 0 0 21.56l7.98-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          Continue with Google
        </button>

        <!-- Divider -->
        <div class="relative flex items-center py-1">
          <div class="flex-grow border-t border-[#2e2e2e]"></div>
          <span class="mx-4 shrink-0 text-xs font-medium uppercase tracking-wider text-gray-500">or</span>
          <div class="flex-grow border-t border-[#2e2e2e]"></div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block mb-1.5 text-sm font-medium text-gray-300">Email</label>
            <input type="email" placeholder="you@example.com" required class="w-full rounded-lg border border-[#2e2e2e] bg-[#252525] px-4 py-3 text-sm text-white placeholder-gray-500 transition-all duration-200 focus:border-[#8b5cf6] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/30" />
          </div>
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label class="block text-sm font-medium text-gray-300">Password</label>
              <button type="button" class="text-xs text-[#8b5cf6] hover:text-[#a78bfa] transition-colors cursor-pointer">Forgot password?</button>
            </div>
            <input type="password" placeholder="••••••••" required class="w-full rounded-lg border border-[#2e2e2e] bg-[#252525] px-4 py-3 text-sm text-white placeholder-gray-500 transition-all duration-200 focus:border-[#8b5cf6] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/30" />
          </div>
        </div>
        <button type="submit" class="w-full rounded-lg bg-[#8b5cf6] px-4 py-3 text-sm font-semibold text-white transition-all duration-200 hover:bg-[#7c3aed] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]/50 focus:ring-offset-2 focus:ring-offset-[#1c1c1c] cursor-pointer">
          Login
        </button>
      </form>

      <p class="mt-8 text-center text-sm text-gray-400">
        Don't have an account?
        <button type="button" class="toggle-to-signup font-medium text-[#8b5cf6] hover:text-[#a78bfa] transition-colors cursor-pointer">Sign up</button>
      </p>
    </div>

    <!-- ────────── Terms / Privacy ────────── -->
    <p class="mt-6 text-center text-[11px] leading-relaxed text-gray-600">
      By continuing you agree to our
      <a href="#" class="underline underline-offset-2 hover:text-gray-400 transition-colors">Terms of Service</a>
      and
      <a href="#" class="underline underline-offset-2 hover:text-gray-400 transition-colors">Privacy Policy</a>.
    </p>
  </div>
</div>

<!-- Custom Professional Popup (Hidden by default) -->
<div id="custom-popup" class="fixed inset-0 flex items-center justify-center z-50 hidden bg-black/60 backdrop-blur-sm transition-opacity">
  <div class="bg-gray-900 border border-gray-700 rounded-2xl p-8 shadow-2xl text-center max-w-sm w-full mx-4">
    <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-purple-900/30 mb-5">
      <svg class="h-8 w-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">Success!</h3>
    <p id="popup-message" class="text-gray-400 mb-6">Your account has been created successfully.</p>
    <button id="close-popup-btn" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-4 rounded-xl transition-colors">
      Continue
    </button>
  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  // --- TOGGLE LOGIC ---
  const signupView = document.getElementById('signup-view');
  const loginView = document.getElementById('login-view');
  
  // --- URL PARAMS INITIALIZATION ---
  const urlParams = new URLSearchParams(window.location.search);
  const mode = urlParams.get('mode');

  if (mode === 'signin') {
    signupView.classList.add('hidden');
    loginView.classList.remove('hidden');
  } else {
    // Default is signup, which is already visible
    loginView.classList.add('hidden');
    signupView.classList.remove('hidden');
  }

  document.querySelectorAll('.toggle-to-login').forEach(btn => {
    btn.addEventListener('click', () => {
      signupView.classList.add('hidden');
      loginView.classList.remove('hidden');
    });
  });

  document.querySelectorAll('.toggle-to-signup').forEach(btn => {
    btn.addEventListener('click', () => {
      loginView.classList.add('hidden');
      signupView.classList.remove('hidden');
    });
  });

  // --- GOOGLE OAUTH ---
  const googleBtns = document.querySelectorAll('.google-auth-trigger');
  googleBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/tools/keyword-optimizer' }
      });
      if (error) alert("Google Auth Error: " + error.message);
    });
  });

  // --- UI Elements for Popup ---
  const customPopup = document.querySelector('#custom-popup');
  const closePopupBtn = document.querySelector('#close-popup-btn');
  const popupMessage = document.querySelector('#popup-message');

  // Function to show the beautiful popup
  function showSuccess(message) {
    popupMessage.textContent = message;
    customPopup.classList.remove('hidden');
  }

  // Close popup button logic
  if (closePopupBtn) {
    closePopupBtn.addEventListener('click', () => {
      customPopup.classList.add('hidden');
      // Optional: Automatically switch them to the login view here
      document.querySelector('#signup-view').classList.add('hidden');
      document.querySelector('#login-view').classList.remove('hidden');
    });
  }

  // --- SIGN UP LOGIC (Email & Password) ---
  const signupForm = document.querySelector('#signup-form');
  if (signupForm) {
    signupForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = signupForm.querySelector('input[type="email"]').value;
      const password = signupForm.querySelector('input[type="password"]').value;

      console.log("Attempting sign up for:", email);

      const { data, error } = await supabase.auth.signUp({
        email: email,
        password: password,
      });

      if (error) {
        // We can still log errors to the console, or you can build an error popup later!
        console.error("Sign Up Error: " + error.message);
      } else {
        // TRIGGER THE PROFESSIONAL POPUP INSTEAD OF THE ALERT
        showSuccess("Account created successfully! You can now log in.");
      }
    });
  }

  // --- LOGIN LOGIC (Email & Password) ---
  const loginForm = document.querySelector('#login-form');
  if (loginForm) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = loginForm.querySelector('input[type="email"]').value;
      const password = loginForm.querySelector('input[type="password"]').value;

      console.log("Attempting login for:", email);

      const { data, error } = await supabase.auth.signInWithPassword({
        email: email,
        password: password,
      });

      if (error) {
        alert("Login Error: " + error.message);
      } else {
        console.log("Login successful! Redirecting...");
        window.location.href = "/tools/keyword-optimizer";
      }
    });
  }
</script>
