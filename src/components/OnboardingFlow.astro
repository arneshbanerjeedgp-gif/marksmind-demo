---
/**
 * OnboardingFlow.astro
 * ──────────────────────────────────────────────────
 * Premium PLG onboarding — MarksMind brand-native.
 *
 * Design tokens pulled directly from the existing
 * dashboard & AuthForm components:
 *   bg-body     #0b0b0c
 *   bg-surface  #161618
 *   bg-card     #1c1c1c
 *   bg-input    #252525
 *   border      #2a2a2c  /  #2e2e2e
 *   text-1      #f3f3f4
 *   text-2      #9aa0a6
 *   accent      #8b5cf6
 *   accent-hov  #7c3aed
 *   accent-lt   #a78bfa
 *   font        Plus Jakarta Sans
 */
import { GraduationCap, User, Languages, BookOpen, Megaphone, CalendarClock, FlaskConical, Target, Sparkles, BrainCircuit } from 'lucide-astro';
import { ONBOARDING_QUESTIONS } from '../config/constants';

const getQ = (id: string) => ONBOARDING_QUESTIONS.find(q => q.id === id);
---

<!-- ═══════════════════════  MARKUP  ═══════════════════════ -->
<div id="ob-root" data-prompts={JSON.stringify(DIAGNOSTIC_PROMPTS)}>

    <!-- ── Progress Header ── -->
    <div id="ob-header">
        <div id="ob-step-counter">1 of 8</div>
        <div id="ob-progress-wrap">
            <div id="ob-progress-bar"></div>
        </div>
    </div>

    <!-- ─── Step 1 : Class Level  ·  GRID ─── -->
    <section class="ob-step active" data-step="1">
        <div class="ob-icon-wrap"><GraduationCap class="ob-icon" /></div>
        <h1 class="ob-title">{getQ('1')?.title}</h1>
        <p class="ob-subtitle">{getQ('1')?.subtitle}</p>
        <div class="ob-grid ob-grid--3">
            {getQ('1')?.options.map(opt => (
                <button class="ob-pill" data-field={getQ('1')?.field} data-val={opt.value} tabindex="0" aria-label={opt.label}>{opt.label}</button>
            ))}
        </div>
    </section>

    <!-- ─── Step 2 : Full Name  ·  INPUT ─── -->
    <section class="ob-step" data-step="2">
        <div class="ob-icon-wrap"><User class="ob-icon" /></div>
        <h1 class="ob-title">What's your name?</h1>
        <p class="ob-subtitle">We'll use this to personalize your experience.</p>
        <div class="ob-input-wrap">
            <input type="text" id="ob-name" class="ob-input" placeholder="Enter your full name" autocomplete="off" spellcheck="false" />
        </div>
        <button id="ob-name-next" class="ob-bottom-link">Continue →</button>
    </section>

    <!-- ─── Step 3 : Code-mix Language  ·  LIST ─── -->
    <section class="ob-step" data-step="3">
        <div class="ob-icon-wrap"><Languages class="ob-icon" /></div>
        <h1 class="ob-title">{getQ('3')?.title}</h1>
        <p class="ob-subtitle">{getQ('3')?.subtitle}</p>
        <div class="ob-list">
            {getQ('3')?.options.map(opt => (
                <button class="ob-list-card" data-field={getQ('3')?.field} data-val={opt.value} tabindex="0" aria-label={opt.label}>
                    <span class="ob-list-title">{opt.label}</span>
                    <span class="ob-list-sub">{opt.sublabel}</span>
                </button>
            ))}
        </div>
    </section>

    <!-- ─── Step 4 : Tuition Type  ·  GRID ─── -->
    <section class="ob-step" data-step="4">
        <div class="ob-icon-wrap"><BookOpen class="ob-icon" /></div>
        <h1 class="ob-title">{getQ('4')?.title}</h1>
        <p class="ob-subtitle">{getQ('4')?.subtitle}</p>
        <div class="ob-grid ob-grid--2">
            {getQ('4')?.options.map(opt => (
                <button class="ob-pill" data-field={getQ('4')?.field} data-val={opt.value} tabindex="0" aria-label={opt.label}>{opt.label}</button>
            ))}
        </div>
    </section>

    <!-- ─── Step 5 : Acquisition Channel  ·  GRID ─── -->
    <section class="ob-step" data-step="5">
        <div class="ob-icon-wrap"><Megaphone class="ob-icon" /></div>
        <h1 class="ob-title">{getQ('5')?.title}</h1>
        <p class="ob-subtitle">{getQ('5')?.subtitle}</p>
        <div class="ob-grid ob-grid--3">
            {getQ('5')?.options.map(opt => (
                <button class="ob-pill" data-field={getQ('5')?.field} data-val={opt.value} tabindex="0" aria-label={opt.label}>{opt.label}</button>
            ))}
        </div>
    </section>

    <!-- ─── Step 6 : Exam Timeline  ·  LIST ─── -->
    <section class="ob-step" data-step="6">
        <div class="ob-icon-wrap"><CalendarClock class="ob-icon" /></div>
        <h1 class="ob-title">{getQ('6')?.title}</h1>
        <p class="ob-subtitle">{getQ('6')?.subtitle}</p>
        <div class="ob-list">
            {getQ('6')?.options.map(opt => (
                <button class="ob-list-card" data-field={getQ('6')?.field} data-val={opt.value} tabindex="0" aria-label={opt.label}>
                    <span class="ob-list-title">{opt.label}</span>
                    <span class="ob-list-sub">{opt.sublabel}</span>
                </button>
            ))}
        </div>
    </section>

    <!-- ─── Step 7 : Weak Subject  ·  GRID ─── -->
    <section class="ob-step" data-step="7">
        <div class="ob-icon-wrap"><FlaskConical class="ob-icon" /></div>
        <h1 class="ob-title">{getQ('7')?.title}</h1>
        <p class="ob-subtitle">{getQ('7')?.subtitle}</p>
        <div class="ob-grid ob-grid--2">
            {getQ('7')?.options.map(opt => (
                <button class="ob-pill" data-field={getQ('7')?.field} data-val={opt.value} tabindex="0" aria-label={opt.label}>{opt.label}</button>
            ))}
        </div>
    </section>

    <!-- ─── Step 8 : Target Score  ·  GRID ─── -->
    <section class="ob-step" data-step="8">
        <div class="ob-icon-wrap"><Target class="ob-icon" /></div>
        <h1 class="ob-title">{getQ('8')?.title}</h1>
        <p class="ob-subtitle">{getQ('8')?.subtitle}</p>
        <div class="ob-grid ob-grid--2">
            {getQ('8')?.options.map(opt => (
                <button class="ob-pill" data-field={getQ('8')?.field} data-val={opt.value} tabindex="0" aria-label={opt.label}>{opt.label}</button>
            ))}
        </div>
    </section>

    <!-- ─── Step 9 : Typewriter Cinematic ─── -->
    <section class="ob-step ob-step--cinema" data-step="9">
        <div id="typewriter-container">
            <span id="typewriter-text"></span><span id="typewriter-cursor">|</span>
        </div>
    </section>

    <!-- ─── Step 10 : Diagnostic Input ─── -->
    <section class="ob-step" data-step="10">
        <div class="ob-diag-badge"><BrainCircuit class="w-3.5 h-3.5 mr-1.5" /> AI Diagnostic</div>
        <h1 class="ob-title">Let's test your knowledge.</h1>
        <p class="ob-subtitle" id="diag-prompt"></p>
        <textarea id="diag-textarea" class="ob-textarea" placeholder="Write your answer here…" rows="4"></textarea>
        <button id="btn-analyze" class="ob-cta-primary">
            <Sparkles class="w-4 h-4 mr-2" /> Analyze My Answer
        </button>
    </section>

    <!-- ─── Step 11 : Loading ─── -->
    <section class="ob-step ob-step--cinema" data-step="11">
        <div class="ob-loader-wrap">
            <div class="ob-pulse-ring"></div>
            <div class="ob-pulse-ring ob-pulse-ring--delay"></div>
            <div class="ob-pulse-dot"></div>
        </div>
        <p class="ob-loader-label">Analyzing your answer<span class="ob-dots"></span></p>
    </section>

    <!-- ─── Step 12 : Mock Results ─── -->
    <section class="ob-step" data-step="12">
        <h1 class="ob-title">Analysis Complete</h1>
        <p class="ob-subtitle" style="margin-bottom:28px;">Here's where your marks are going.</p>

        <div class="ob-results">
            <div class="ob-res-card ob-res-card--score">
                <span class="ob-res-label">Score</span>
                <span class="ob-res-score">2 / 5</span>
            </div>
            <div class="ob-res-card ob-res-card--green">
                <span class="ob-res-tag ob-res-tag--green">STRENGTHS</span>
                <p class="ob-res-body">✔ Correct basic concept identified</p>
            </div>
            <div class="ob-res-card ob-res-card--red">
                <span class="ob-res-tag ob-res-tag--red">IMPROVEMENTS</span>
                <p class="ob-res-body">Missing ATP explanation and metabolic context</p>
            </div>
            <div class="ob-res-card">
                <span class="ob-res-tag">MISSING NCERT CONCEPTS</span>
                <div class="ob-chips">
                    <span class="ob-chip">ATP</span>
                    <span class="ob-chip">Cellular Respiration</span>
                    <span class="ob-chip">Chloroplast</span>
                </div>
            </div>
            <div class="ob-res-card ob-res-card--ceda">
                <div class="ob-ceda-row">
                    <span class="ob-ceda-label">Language Bias Penalty</span>
                    <span class="ob-ceda-value">0</span>
                </div>
                <p class="ob-ceda-sub">CEDA Insulated — No marks lost due to language mixing.</p>
            </div>
            <div class="ob-res-card">
                <div class="ob-gap-row">
                    <div class="ob-gap-item">
                        <span class="ob-gap-label">Current</span>
                        <span class="ob-gap-val ob-gap-val--amber">60%</span>
                    </div>
                    <div class="ob-gap-arrow">→</div>
                    <div class="ob-gap-item">
                        <span class="ob-gap-label">Target</span>
                        <span id="result-target" class="ob-gap-val ob-gap-val--green">90%</span>
                    </div>
                    <div class="ob-gap-arrow">⚡</div>
                    <div class="ob-gap-item">
                        <span class="ob-gap-label">Gap</span>
                        <span id="result-gap" class="ob-gap-val ob-gap-val--red">30%</span>
                    </div>
                </div>
                <div class="ob-bar-track">
                    <div class="ob-bar-fill" style="width:60%"></div>
                    <div id="result-bar-marker" class="ob-bar-marker" style="left:90%"></div>
                </div>
            </div>
        </div>
        <button id="btn-results-next" class="ob-bottom-link" style="margin-top:32px;">Continue →</button>
    </section>

    <!-- ─── Step 13 : Paywall ─── -->
    <section class="ob-step" data-step="13">
        <div class="ob-icon-wrap"><Sparkles class="ob-icon" /></div>
        <h1 class="ob-title">Unlock Premium</h1>
        <p class="ob-subtitle">Unlimited evaluations, model answers, and your AI tutor.</p>

        <div class="ob-pricing-row">
            <!-- Annual -->
            <div class="ob-pricing-card ob-pricing-card--annual">
                <span class="ob-pricing-badge">24% off</span>
                <p class="ob-pricing-period">Annual</p>
                <p class="ob-pricing-amount">₹99<span class="ob-pricing-unit">/mo</span></p>
                <p class="ob-pricing-note">Billed yearly</p>
            </div>
            <!-- Monthly -->
            <div class="ob-pricing-card">
                <p class="ob-pricing-period">Monthly</p>
                <p class="ob-pricing-amount">₹339<span class="ob-pricing-unit">/mo</span></p>
                <p class="ob-pricing-note">Billed monthly</p>
            </div>
        </div>

        <button class="ob-cta-primary" style="margin-top:28px;">✨ Upgrade Now</button>
        <button id="btn-free" class="ob-bottom-link ob-bottom-link--muted" style="margin-top:16px;">Continue with Free Plan</button>
    </section>

</div>

<!-- ═══════════════════════  STYLES  ═══════════════════════ -->
<style is:global>
    /* ────────────────────────────────────────────────
       DESIGN TOKENS  (from MarksMind platform)
       ──────────────────────────────────────────────── */
    :root {
        --mm-bg:        #0b0b0c;
        --mm-surface:   #161618;
        --mm-card:      #1c1c1c;
        --mm-input:     #252525;
        --mm-border:    #2a2a2c;
        --mm-border-lt: #2e2e2e;
        --mm-text-1:    #f3f3f4;
        --mm-text-2:    #9aa0a6;
        --mm-text-3:    rgba(255,255,255,0.35);
        --mm-accent:    #8b5cf6;
        --mm-accent-hv: #7c3aed;
        --mm-accent-lt: #a78bfa;
        --mm-green:     #22c55e;
        --mm-red:       #ef4444;
        --mm-amber:     #fbbf24;
        --mm-ease:      cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ──── Reset ──── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
        background: var(--mm-bg);
        color: var(--mm-text-1);
        overflow-x: hidden;
    }

    /* ──── Root Container ──── */
    #ob-root {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 20px 48px;
    }

    /* ──── Progress Header ──── */
    #ob-header {
        position: fixed;
        top: 0; left: 0; right: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px 24px 0;
        z-index: 100;
        transition: opacity 0.5s ease;
    }
    #ob-step-counter {
        font-size: 13px;
        font-weight: 600;
        color: var(--mm-text-2);
        letter-spacing: 0.3px;
        margin-bottom: 10px;
        transition: opacity 0.3s ease;
    }
    #ob-step-counter.hidden { opacity: 0; pointer-events: none; }
    #ob-progress-wrap {
        width: 100%;
        max-width: 400px;
        height: 3px;
        background: var(--mm-border);
        border-radius: 2px;
    }
    #ob-progress-bar {
        height: 100%;
        width: 0%;
        background: var(--mm-accent);
        border-radius: 2px;
        transition: width 0.5s var(--mm-ease);
    }

    /* ──── Step Containers ──── */
    .ob-step {
        display: none;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 440px;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.45s var(--mm-ease),
                    transform 0.45s var(--mm-ease);
    }
    .ob-step.active  { display: flex; }
    .ob-step.visible { opacity: 1; transform: translateY(0); }
    .ob-step--cinema { max-width: 580px; }

    /* ──── Icon ──── */
    .ob-icon-wrap {
        width: 48px; height: 48px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 14px;
        background: var(--mm-surface);
        border: 1px solid var(--mm-border);
        margin-bottom: 20px;
    }
    .ob-icon { width: 22px; height: 22px; color: var(--mm-accent-lt); }

    /* ──── Typography ──── */
    .ob-title {
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.3px;
        line-height: 1.25;
        color: var(--mm-text-1);
        margin-bottom: 8px;
    }
    .ob-subtitle {
        font-size: 14px;
        color: var(--mm-text-2);
        line-height: 1.5;
        margin-bottom: 28px;
        max-width: 360px;
    }

    /* ──── VARIATION A : Pill Grid ──── */
    .ob-grid { display: grid; gap: 10px; width: 100%; }
    .ob-grid--2 { grid-template-columns: 1fr 1fr; }
    .ob-grid--3 { grid-template-columns: 1fr 1fr 1fr; }
    @media (max-width: 420px) { .ob-grid--3 { grid-template-columns: 1fr 1fr; } }

    .ob-pill {
        appearance: none;
        border: 1px solid var(--mm-border);
        background: var(--mm-surface);
        color: var(--mm-text-1);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        padding: 14px 10px;
        border-radius: 9999px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }
    .ob-pill:hover {
        background: var(--mm-card);
        border-color: var(--mm-border-lt);
    }
    .ob-pill:active { transform: scale(0.96); }
    .ob-pill.selected {
        background: var(--mm-accent);
        border-color: var(--mm-accent);
        color: #fff;
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
    }

    /* ──── VARIATION B : List Cards ──── */
    .ob-list { display: flex; flex-direction: column; gap: 10px; width: 100%; }

    .ob-list-card {
        appearance: none;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        width: 100%;
        border: 1px solid var(--mm-border);
        background: var(--mm-surface);
        border-radius: 16px;
        padding: 16px 20px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }
    .ob-list-card:hover {
        background: var(--mm-card);
        border-color: var(--mm-border-lt);
    }
    .ob-list-card:active { transform: scale(0.98); }
    .ob-list-card.selected {
        background: var(--mm-accent);
        border-color: var(--mm-accent);
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
    }
    .ob-list-card.selected .ob-list-title { color: #fff; }
    .ob-list-card.selected .ob-list-sub   { color: rgba(255,255,255,0.7); }

    .ob-list-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--mm-text-1);
        line-height: 1.3;
    }
    .ob-list-sub {
        font-size: 12px;
        color: var(--mm-text-2);
        margin-top: 2px;
    }

    /* ──── Text Input ──── */
    .ob-input-wrap { width: 100%; margin-bottom: 20px; }
    .ob-input {
        width: 100%;
        appearance: none;
        border: 1px solid var(--mm-border-lt);
        border-radius: 12px;
        background: var(--mm-input);
        color: var(--mm-text-1);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 16px;
        font-weight: 500;
        padding: 16px 18px;
        outline: none;
        transition: all 0.2s ease;
    }
    .ob-input::placeholder { color: rgba(255,255,255,0.2); }
    .ob-input:focus {
        border-color: var(--mm-accent);
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
    }
    .ob-input.shake {
        animation: shake 0.4s ease;
        border-color: var(--mm-red);
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
    }
    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
    }

    /* ──── Bottom Navigation Link ──── */
    .ob-bottom-link {
        appearance: none;
        background: none;
        border: none;
        color: var(--mm-accent-lt);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        padding: 12px 0;
        transition: color 0.2s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .ob-bottom-link:hover { color: var(--mm-text-1); }
    .ob-bottom-link--muted {
        font-size: 13px;
        font-weight: 500;
        color: var(--mm-text-2);
    }
    .ob-bottom-link--muted:hover { color: var(--mm-text-1); }

    /* ──── Primary CTA (Dashboard-matching) ──── */
    .ob-cta-primary {
        appearance: none;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 12px;
        background: var(--mm-accent);
        color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 15px;
        font-weight: 600;
        padding: 15px 24px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        -webkit-tap-highlight-color: transparent;
    }
    .ob-cta-primary:hover {
        background: var(--mm-accent-hv);
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
    }
    .ob-cta-primary:active { transform: scale(0.98); }

    /* Step counter styles are now in #ob-header above */

    /* ──── Typewriter ──── */
    #typewriter-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 160px;
        padding: 0 16px;
        width: 100%;
    }
    #typewriter-text {
        font-size: clamp(20px, 5vw, 40px);
        font-weight: 700;
        letter-spacing: -0.4px;
        line-height: 1.35;
        color: var(--mm-text-1);
        text-align: center;
        max-width: 640px;
    }
    #typewriter-cursor {
        display: inline-block;
        font-size: clamp(20px, 5vw, 40px);
        font-weight: 300;
        color: var(--mm-accent);
        animation: blink 0.8s step-end infinite;
        margin-left: 2px;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

    /* ──── Diagnostic ──── */
    .ob-diag-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 9999px;
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.15);
        color: var(--mm-accent-lt);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.3px;
        margin-bottom: 16px;
    }
    .ob-textarea {
        width: 100%;
        appearance: none;
        border: 1px solid var(--mm-border);
        border-radius: 12px;
        background: var(--mm-surface);
        color: var(--mm-text-1);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        line-height: 1.6;
        padding: 16px 18px;
        outline: none;
        resize: none;
        min-height: 110px;
        transition: all 0.2s ease;
        margin-bottom: 16px;
    }
    .ob-textarea::placeholder { color: rgba(255,255,255,0.18); }
    .ob-textarea:focus {
        border-color: var(--mm-accent);
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
    }

    /* ──── Loader ──── */
    .ob-loader-wrap {
        position: relative;
        width: 72px; height: 72px;
        margin-bottom: 28px;
    }
    .ob-pulse-ring {
        position: absolute; inset: 0;
        border: 2px solid rgba(139, 92, 246, 0.25);
        border-radius: 50%;
        animation: pulse-ring 1.8s var(--mm-ease) infinite;
    }
    .ob-pulse-ring--delay { animation-delay: 0.6s; }
    .ob-pulse-dot {
        position: absolute;
        top: 50%; left: 50%;
        width: 10px; height: 10px;
        margin: -5px 0 0 -5px;
        background: var(--mm-accent);
        border-radius: 50%;
        box-shadow: 0 0 16px rgba(139, 92, 246, 0.4);
    }
    @keyframes pulse-ring {
        0%   { transform: scale(0.5); opacity: 0.8; }
        100% { transform: scale(1.8); opacity: 0; }
    }
    .ob-loader-label { font-size: 14px; color: var(--mm-text-2); font-weight: 500; }
    .ob-dots::after { content: ''; animation: dots 1.5s steps(4, end) infinite; }
    @keyframes dots {
        0%{content:''} 25%{content:'.'} 50%{content:'..'} 75%{content:'...'}
    }

    /* ──── Results Dashboard ──── */
    .ob-results { width: 100%; display: flex; flex-direction: column; gap: 10px; }
    .ob-res-card {
        background: var(--mm-surface);
        border: 1px solid var(--mm-border);
        border-radius: 14px;
        padding: 16px 18px;
        text-align: left;
    }
    .ob-res-card--score { display: flex; justify-content: space-between; align-items: center; }
    .ob-res-card--green { border-left: 3px solid var(--mm-green); }
    .ob-res-card--red   { border-left: 3px solid var(--mm-red); }
    .ob-res-card--ceda  {
        background: rgba(139, 92, 246, 0.05);
        border-color: rgba(139, 92, 246, 0.12);
    }
    .ob-res-label { font-size: 13px; color: var(--mm-text-2); font-weight: 500; }
    .ob-res-score { font-size: 22px; font-weight: 700; color: var(--mm-amber); }
    .ob-res-tag {
        font-size: 10px; font-weight: 700; letter-spacing: 1px;
        text-transform: uppercase; color: var(--mm-text-3);
        margin-bottom: 6px; display: block;
    }
    .ob-res-tag--green { color: #4ade80; }
    .ob-res-tag--red   { color: #f87171; }
    .ob-res-body { font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.5; }

    .ob-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
    .ob-chip {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 9999px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--mm-border);
        font-size: 11px;
        font-weight: 500;
        color: rgba(255,255,255,0.55);
    }

    .ob-ceda-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .ob-ceda-label { font-size: 13px; font-weight: 600; color: var(--mm-accent-lt); }
    .ob-ceda-value {
        font-size: 26px; font-weight: 800; color: var(--mm-green);
        text-shadow: 0 0 12px rgba(34, 197, 94, 0.35);
    }
    .ob-ceda-sub { font-size: 11px; color: var(--mm-text-3); }

    .ob-gap-row {
        display: flex; justify-content: space-between;
        align-items: center; margin-bottom: 14px;
    }
    .ob-gap-item { text-align: center; }
    .ob-gap-label {
        display: block; font-size: 10px; color: var(--mm-text-3);
        margin-bottom: 3px; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;
    }
    .ob-gap-val { font-size: 20px; font-weight: 700; }
    .ob-gap-val--amber { color: var(--mm-amber); }
    .ob-gap-val--green { color: var(--mm-green); }
    .ob-gap-val--red   { color: var(--mm-red); }
    .ob-gap-arrow { color: var(--mm-text-3); font-size: 16px; }

    .ob-bar-track {
        width: 100%; height: 5px;
        background: var(--mm-border);
        border-radius: 9999px;
        position: relative; overflow: visible;
    }
    .ob-bar-fill {
        height: 100%; border-radius: 9999px;
        background: linear-gradient(90deg, var(--mm-amber), #f59e0b);
        transition: width 1s ease;
    }
    .ob-bar-marker {
        position: absolute; top: -4px;
        width: 3px; height: 13px;
        background: var(--mm-green);
        border-radius: 2px;
        box-shadow: 0 0 6px rgba(34,197,94,0.4);
    }

    /* ──── Paywall ──── */
    .ob-pricing-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        width: 100%;
    }
    .ob-pricing-card {
        background: var(--mm-surface);
        border: 1px solid var(--mm-border);
        border-radius: 18px;
        padding: 22px 14px;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: all 0.2s ease;
    }
    .ob-pricing-card--annual {
        border-color: rgba(139, 92, 246, 0.25);
        background: rgba(139, 92, 246, 0.04);
    }
    .ob-pricing-badge {
        position: absolute;
        top: 0; right: 0;
        background: var(--mm-accent);
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 0 16px 0 8px;
    }
    .ob-pricing-period { font-size: 12px; color: var(--mm-text-2); margin-bottom: 4px; }
    .ob-pricing-amount { font-size: 28px; font-weight: 700; color: var(--mm-text-1); }
    .ob-pricing-unit { font-size: 13px; font-weight: 500; color: var(--mm-text-2); }
    .ob-pricing-note { font-size: 11px; color: var(--mm-text-3); margin-top: 4px; }
</style>

<!-- ═══════════════════════  SCRIPT  ═══════════════════════ -->
<script>
    // ── Loop Breaker ──
    const ATTEMPTS_KEY = 'onboarding_attempts';
    let attempts = parseInt(localStorage.getItem(ATTEMPTS_KEY) || '0', 10);
    attempts++;
    localStorage.setItem(ATTEMPTS_KEY, String(attempts));
    if (attempts >= 6) { window.location.href = '/tools/keyword-optimizer'; }

    /** 
     * @typedef {Object} OnboardingState 
     * @property {string} class_level
     * @property {string} full_name
     * @property {string} code_mix_lang
     * @property {string} tuition_type
     * @property {string} acquisition_channel
     * @property {string} exam_timeline
     * @property {string} weak_subject
     * @property {string} target_score
     */

    // ── State ──
    /** @type {OnboardingState} */
    const state = {
        class_level: '', full_name: '', code_mix_lang: '',
        tuition_type: '', acquisition_channel: '', exam_timeline: '',
        weak_subject: '', target_score: ''
    };
    let currentStep = 1;
    const TOTAL_Q = 8;
    const root = document.getElementById('ob-root');
    const DIAGNOSTIC_PROMPTS = JSON.parse(root?.getAttribute('data-prompts') || '{}');

    // ── DOM ──
    const progressBar = document.getElementById('ob-progress-bar');

    // ── Transition Engine ──
    function goToStep(n) {
        const cur = document.querySelector('.ob-step.active');
        if (cur) {
            cur.classList.remove('visible');
            setTimeout(() => {
                cur.classList.remove('active');
                mount(n);
            }, 380);
        } else {
            mount(n);
        }
    }

    function mount(n) {
        currentStep = n;
        const el = document.querySelector(`.ob-step[data-step="${n}"]`);
        if (!el) return;
        el.classList.add('active');
        void el.offsetWidth;            // force reflow
        requestAnimationFrame(() => el.classList.add('visible'));

        // Progress header — hide entirely after Q8 for cinematic effect
        const header = document.getElementById('ob-header');
        if (n <= TOTAL_Q) {
            header.style.opacity = '1';
            header.style.pointerEvents = 'auto';
            progressBar.style.width = `${(n / TOTAL_Q) * 100}%`;
            const counter = document.getElementById('ob-step-counter');
            counter.textContent = `${n} of ${TOTAL_Q}`;
        } else {
            header.style.opacity = '0';
            header.style.pointerEvents = 'none';
        }

        // Hooks
        if (n === 9)  startTypewriter();
        if (n === 10) setupDiagnostic();
        if (n === 11) runMockAnalysis();
        if (n === 12) setupResults();
    }

    // ── Boot ──
    requestAnimationFrame(() => {
        const first = document.querySelector('.ob-step[data-step="1"]');
        if (first) { void first.offsetWidth; first.classList.add('visible'); }
        progressBar.style.width = `${(1 / TOTAL_Q) * 100}%`;
        document.getElementById('ob-step-counter').textContent = `1 of ${TOTAL_Q}`;
    });

    // ── Pill Buttons (Variation A) ──
    document.querySelectorAll('.ob-pill').forEach(btn => {
        btn.addEventListener('click', () => {
            const field = btn.getAttribute('data-field');
            const val   = btn.getAttribute('data-val');
            btn.parentElement.querySelectorAll('.ob-pill').forEach(s => s.classList.remove('selected'));
            btn.classList.add('selected');
            state[field] = val;
            setTimeout(() => goToStep(currentStep + 1), 320);
        });
    });

    // ── List Cards (Variation B) ──
    document.querySelectorAll('.ob-list-card').forEach(btn => {
        btn.addEventListener('click', () => {
            const field = btn.getAttribute('data-field');
            const val   = btn.getAttribute('data-val');
            btn.parentElement.querySelectorAll('.ob-list-card').forEach(s => s.classList.remove('selected'));
            btn.classList.add('selected');
            state[field] = val;
            setTimeout(() => goToStep(currentStep + 1), 320);
        });
    });

    // ── Name Input ──
    const nameInput = document.getElementById('ob-name');
    const nameBtn   = document.getElementById('ob-name-next');

    nameBtn?.addEventListener('click', () => {
        const val = nameInput.value.trim();
        if (!val) {
            nameInput.classList.add('shake');
            setTimeout(() => nameInput.classList.remove('shake'), 500);
            return;
        }
        state.full_name = val;
        goToStep(currentStep + 1);
    });
    nameInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') nameBtn?.click();
    });

    // ── Typewriter Engine ──
    function startTypewriter() {
        const textEl   = document.getElementById('typewriter-text');
        const cursorEl = document.getElementById('typewriter-cursor');

        const lines = [
            `${state.full_name}, your goal is ${state.target_score}.`,
            "Most students don't lose marks because they don't study.",
            "They lose marks because their answers miss what examiners expect.",
            "Let's find where your marks are going."
        ];
        let lineIdx = 0;

        function typeLine() {
            if (lineIdx >= lines.length) {
                cursorEl.style.display = 'none';
                setTimeout(() => goToStep(10), 500);
                return;
            }
            const line = lines[lineIdx];
            let ci = 0;
            textEl.textContent = '';
            textEl.style.opacity = '1';
            cursorEl.style.display = 'inline-block';

            function typeChar() {
                if (ci < line.length) {
                    textEl.textContent += line[ci];
                    ci++;
                    setTimeout(typeChar, 35);
                } else {
                    setTimeout(() => {
                        textEl.style.transition = 'opacity 0.7s ease';
                        textEl.style.opacity = '0';
                        setTimeout(() => {
                            textEl.style.transition = 'none';
                            lineIdx++;
                            typeLine();
                        }, 800);
                    }, 1500);
                }
            }
            typeChar();
        }
        setTimeout(typeLine, 700);
    }

    // ── Diagnostic ──
    function setupDiagnostic() {
        const prompt = document.getElementById('diag-prompt');
        if (prompt) {
            prompt.textContent = DIAGNOSTIC_PROMPTS[state.weak_subject] || DIAGNOSTIC_PROMPTS['Science'] || 'Explain the process of Photosynthesis.';
        }

        const ta = document.getElementById('diag-textarea');
        ta?.addEventListener('input', () => {
            ta.style.height = 'auto';
            ta.style.height = ta.scrollHeight + 'px';
        });
    }

    document.getElementById('btn-analyze')?.addEventListener('click', () => goToStep(11));

    async function runMockAnalysis() { 
        try {
            // Simulate API Call delay
            await new Promise((resolve) => setTimeout(resolve, 3000));
            
            // For production, actual fetch logic goes here.
            // if (!response.ok) throw new Error('API Error');

            goToStep(12);
        } catch (error) {
            console.error("Analysis API failed:", error);
            // Graceful Fallback UI
            const label = document.querySelector('.ob-loader-label');
            if (label) {
                label.textContent = "Something went wrong. Please try again.";
                label.classList.add('shake');
            }
            setTimeout(() => goToStep(10), 3000); // Send back to retry
        }
    }

    // ── Results ──
    function setupResults() {
        const tNum = parseInt(state.target_score?.replace('%','').replace('Above ','')) || 90;
        const gap = Math.max(0, tNum - 60);
        document.getElementById('result-target').textContent = state.target_score || '90%';
        document.getElementById('result-gap').textContent = gap + '%';
        const marker = document.getElementById('result-bar-marker');
        if (marker) marker.style.left = Math.min(tNum, 100) + '%';
    }

    document.getElementById('btn-results-next')?.addEventListener('click', () => goToStep(13));

    // ── Paywall ──
    document.getElementById('btn-free')?.addEventListener('click', () => {
        localStorage.removeItem(ATTEMPTS_KEY);
        window.location.href = '/dashboard';
    });
</script>
