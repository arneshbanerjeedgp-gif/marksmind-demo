---
/**
 * OnboardingFlow.astro
 * ──────────────────────────────────────────────────
 * Premium PLG onboarding — iOS-native aesthetic.
 * Pure Vanilla JS state machine + typewriter engine.
 * No framework dependencies. No auth guard.
 */
---

<!-- ═══════════════════════  MARKUP  ═══════════════════════ -->
<div id="ob-root">

    <!-- Progress bar -->
    <div id="ob-progress-wrap">
        <div id="ob-progress-bar"></div>
    </div>

    <!-- ─── Step 1 : Class Level ─── -->
    <section class="ob-step active" data-step="1">
        <p class="ob-eyebrow">Step 1 of 8</p>
        <h1 class="ob-title">Which class are you in?</h1>
        <div class="ob-grid ob-grid--3">
            <button class="ob-option" data-field="class_level" data-val="Class 8">Class 8</button>
            <button class="ob-option" data-field="class_level" data-val="Class 9">Class 9</button>
            <button class="ob-option" data-field="class_level" data-val="Class 10">Class 10</button>
            <button class="ob-option" data-field="class_level" data-val="Class 11">Class 11</button>
            <button class="ob-option" data-field="class_level" data-val="Class 12">Class 12</button>
        </div>
    </section>

    <!-- ─── Step 2 : Full Name ─── -->
    <section class="ob-step" data-step="2">
        <p class="ob-eyebrow">Step 2 of 8</p>
        <h1 class="ob-title">What's your name?</h1>
        <p class="ob-subtitle">We'll use this to personalize your experience.</p>
        <div class="ob-input-wrap">
            <input type="text" id="ob-name" class="ob-input" placeholder="Enter your full name" autocomplete="off" spellcheck="false" />
        </div>
        <button id="ob-name-next" class="ob-cta">Continue</button>
    </section>

    <!-- ─── Step 3 : Code-mix Language ─── -->
    <section class="ob-step" data-step="3">
        <p class="ob-eyebrow">Step 3 of 8</p>
        <h1 class="ob-title">Answer Language</h1>
        <p class="ob-subtitle">What language do you mix when writing answers?</p>
        <div class="ob-grid ob-grid--1">
            <button class="ob-option" data-field="code_mix_lang" data-val="English Only">English Only</button>
            <button class="ob-option" data-field="code_mix_lang" data-val="English + Bengali">English + Bengali</button>
            <button class="ob-option" data-field="code_mix_lang" data-val="English + Hindi">English + Hindi</button>
        </div>
    </section>

    <!-- ─── Step 4 : Tuition Type ─── -->
    <section class="ob-step" data-step="4">
        <p class="ob-eyebrow">Step 4 of 8</p>
        <h1 class="ob-title">How do you study?</h1>
        <div class="ob-grid ob-grid--2">
            <button class="ob-option" data-field="tuition_type" data-val="School Only">🏫  School Only</button>
            <button class="ob-option" data-field="tuition_type" data-val="Local Tutor">👨‍🏫  Local Tutor</button>
            <button class="ob-option" data-field="tuition_type" data-val="Coaching + School">🎓  Coaching + School</button>
            <button class="ob-option" data-field="tuition_type" data-val="No Classes">📚  No Classes (Self)</button>
        </div>
    </section>

    <!-- ─── Step 5 : Acquisition Channel ─── -->
    <section class="ob-step" data-step="5">
        <p class="ob-eyebrow">Step 5 of 8</p>
        <h1 class="ob-title">How did you find us?</h1>
        <div class="ob-grid ob-grid--3">
            <button class="ob-option" data-field="acquisition_channel" data-val="Google">Google</button>
            <button class="ob-option" data-field="acquisition_channel" data-val="YouTube">YouTube</button>
            <button class="ob-option" data-field="acquisition_channel" data-val="Friend">Friend</button>
            <button class="ob-option" data-field="acquisition_channel" data-val="X">X (Twitter)</button>
            <button class="ob-option" data-field="acquisition_channel" data-val="Other">Other</button>
        </div>
    </section>

    <!-- ─── Step 6 : Exam Timeline ─── -->
    <section class="ob-step" data-step="6">
        <p class="ob-eyebrow">Step 6 of 8</p>
        <h1 class="ob-title">When's your next big exam?</h1>
        <div class="ob-grid ob-grid--2">
            <button class="ob-option" data-field="exam_timeline" data-val="This Week">This Week</button>
            <button class="ob-option" data-field="exam_timeline" data-val="This Month">This Month</button>
            <button class="ob-option" data-field="exam_timeline" data-val="In a Few Months">In a Few Months</button>
            <button class="ob-option" data-field="exam_timeline" data-val="Next Year">Next Year</button>
        </div>
    </section>

    <!-- ─── Step 7 : Weak Subject ─── -->
    <section class="ob-step" data-step="7">
        <p class="ob-eyebrow">Step 7 of 8</p>
        <h1 class="ob-title">Which subject needs the most work?</h1>
        <div class="ob-grid ob-grid--2">
            <button class="ob-option" data-field="weak_subject" data-val="English">📖  English</button>
            <button class="ob-option" data-field="weak_subject" data-val="Maths">📐  Maths</button>
            <button class="ob-option" data-field="weak_subject" data-val="Science">🔬  Science</button>
            <button class="ob-option" data-field="weak_subject" data-val="Social Science">🌍  Social Science</button>
        </div>
    </section>

    <!-- ─── Step 8 : Target Score ─── -->
    <section class="ob-step" data-step="8">
        <p class="ob-eyebrow">Step 8 of 8</p>
        <h1 class="ob-title">What's your target score?</h1>
        <div class="ob-grid ob-grid--2">
            <button class="ob-option" data-field="target_score" data-val="70%">70%</button>
            <button class="ob-option" data-field="target_score" data-val="80%">80%</button>
            <button class="ob-option" data-field="target_score" data-val="90%">90%</button>
            <button class="ob-option" data-field="target_score" data-val="Above 95%">Above 95%</button>
        </div>
    </section>

    <!-- ─── Step 9 : Typewriter Cinematic ─── -->
    <section class="ob-step ob-step--cinema" data-step="9">
        <div id="typewriter-container">
            <span id="typewriter-text"></span>
            <span id="typewriter-cursor">|</span>
        </div>
    </section>

    <!-- ─── Step 10 : Diagnostic Input ─── -->
    <section class="ob-step" data-step="10">
        <div class="ob-diag-badge">🧠 AI Diagnostic</div>
        <h1 class="ob-title">Let's test your knowledge.</h1>
        <p class="ob-subtitle" id="diag-prompt"></p>
        <textarea id="diag-textarea" class="ob-textarea" placeholder="Write your answer here..." rows="4"></textarea>
        <button id="btn-analyze" class="ob-cta ob-cta--gradient">Analyze My Answer</button>
    </section>

    <!-- ─── Step 11 : Loading ─── -->
    <section class="ob-step ob-step--cinema" data-step="11">
        <div class="ob-loader-wrap">
            <div class="ob-pulse-ring"></div>
            <div class="ob-pulse-ring ob-pulse-ring--2"></div>
            <div class="ob-pulse-dot"></div>
        </div>
        <p class="ob-loader-text">Analyzing your answer<span class="ob-dots"></span></p>
    </section>

    <!-- ─── Step 12 : Mock Results ─── -->
    <section class="ob-step" data-step="12">
        <h1 class="ob-title" style="margin-bottom: 8px;">Analysis Complete</h1>
        <p class="ob-subtitle" style="margin-bottom: 32px;">Here's where your marks are going.</p>

        <div class="ob-results">
            <!-- Score Card -->
            <div class="ob-result-card ob-result-card--score">
                <span class="ob-result-label">Score</span>
                <span class="ob-result-value ob-result-value--amber">2 / 5</span>
            </div>

            <!-- Strengths -->
            <div class="ob-result-card ob-result-card--green">
                <span class="ob-result-tag ob-result-tag--green">STRENGTHS</span>
                <p class="ob-result-body">✔ Correct basic concept identified</p>
            </div>

            <!-- Improvements -->
            <div class="ob-result-card ob-result-card--red">
                <span class="ob-result-tag ob-result-tag--red">IMPROVEMENTS</span>
                <p class="ob-result-body">Missing ATP explanation and metabolic context</p>
            </div>

            <!-- Missing Concepts -->
            <div class="ob-result-card">
                <span class="ob-result-tag">MISSING NCERT CONCEPTS</span>
                <div class="ob-chip-row">
                    <span class="ob-chip">ATP</span>
                    <span class="ob-chip">Cellular Respiration</span>
                    <span class="ob-chip">Chloroplast</span>
                </div>
            </div>

            <!-- CEDA Badge -->
            <div class="ob-result-card ob-result-card--ceda">
                <div class="ob-ceda-badge">
                    <span class="ob-ceda-label">Language Bias Penalty</span>
                    <span class="ob-ceda-value">0</span>
                </div>
                <p class="ob-ceda-sub">CEDA Insulated — No marks lost due to language mixing.</p>
            </div>

            <!-- Gap Comparison -->
            <div class="ob-result-card">
                <div class="ob-gap-row">
                    <div class="ob-gap-item">
                        <span class="ob-gap-label">Current</span>
                        <span class="ob-gap-value ob-gap-value--current">60%</span>
                    </div>
                    <div class="ob-gap-divider">→</div>
                    <div class="ob-gap-item">
                        <span class="ob-gap-label">Target</span>
                        <span id="result-target" class="ob-gap-value ob-gap-value--target">90%</span>
                    </div>
                    <div class="ob-gap-divider">⚡</div>
                    <div class="ob-gap-item">
                        <span class="ob-gap-label">Gap</span>
                        <span id="result-gap" class="ob-gap-value ob-gap-value--gap">30%</span>
                    </div>
                </div>
                <div class="ob-bar-track">
                    <div class="ob-bar-fill" style="width:60%"></div>
                    <div id="result-bar-target" class="ob-bar-marker" style="left:90%"></div>
                </div>
            </div>
        </div>

        <button id="btn-results-next" class="ob-cta" style="margin-top:32px;">Continue</button>
    </section>

    <!-- ─── Step 13 : Paywall ─── -->
    <section class="ob-step" data-step="13">
        <div class="ob-paywall-icon">✦</div>
        <h1 class="ob-title">Unlock Premium</h1>
        <p class="ob-subtitle">Unlimited evaluations, model answers, and your AI tutor.</p>

        <div class="ob-pricing-row">
            <div class="ob-pricing-card ob-pricing-card--popular">
                <span class="ob-pricing-badge">POPULAR</span>
                <p class="ob-pricing-period">Monthly</p>
                <p class="ob-pricing-amount">₹99<span class="ob-pricing-unit">/mo</span></p>
            </div>
            <div class="ob-pricing-card">
                <p class="ob-pricing-period">Yearly</p>
                <p class="ob-pricing-amount">₹799<span class="ob-pricing-unit">/yr</span></p>
                <p class="ob-pricing-save">Save 33%</p>
            </div>
        </div>

        <button class="ob-cta ob-cta--gradient" style="margin-top:32px;">Upgrade Now</button>
        <button id="btn-free" class="ob-cta ob-cta--ghost">Continue with Free Plan</button>
    </section>

</div>

<!-- ═══════════════════════  STYLES  ═══════════════════════ -->
<style is:global>
    /* ──── Reset & Base ──── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
        background: #0A0A0A;
        color: #F5F5F7;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
    }

    /* ──── Root Container ──── */
    #ob-root {
        position: relative;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 20px;
    }

    /* ──── Progress Bar ──── */
    #ob-progress-wrap {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: rgba(255,255,255,0.05);
        z-index: 100;
    }
    #ob-progress-bar {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #8B5CF6, #A78BFA);
        border-radius: 0 2px 2px 0;
        transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ──── Step Containers ──── */
    .ob-step {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        max-width: 480px;
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                    transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .ob-step.active {
        display: flex;
    }
    .ob-step.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .ob-step--cinema {
        max-width: 640px;
    }

    /* ──── Typography ──── */
    .ob-eyebrow {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.25);
        margin-bottom: 16px;
    }
    .ob-title {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.5px;
        line-height: 1.2;
        margin-bottom: 12px;
        color: #F5F5F7;
    }
    .ob-subtitle {
        font-size: 15px;
        color: rgba(255,255,255,0.45);
        line-height: 1.5;
        margin-bottom: 32px;
        max-width: 400px;
    }

    /* ──── Option Grids ──── */
    .ob-grid { display: grid; gap: 12px; width: 100%; margin-top: 8px; }
    .ob-grid--1 { grid-template-columns: 1fr; }
    .ob-grid--2 { grid-template-columns: 1fr 1fr; }
    .ob-grid--3 { grid-template-columns: 1fr 1fr 1fr; }

    @media (max-width: 480px) {
        .ob-grid--3 { grid-template-columns: 1fr 1fr; }
    }

    /* ──── Option Buttons ──── */
    .ob-option {
        appearance: none;
        border: 1px solid rgba(255,255,255,0.08);
        background: #1A1A1A;
        color: #E5E5EA;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 500;
        padding: 16px 12px;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }
    .ob-option:hover {
        background: #222222;
        border-color: rgba(255,255,255,0.15);
        transform: scale(1.03);
    }
    .ob-option:active {
        transform: scale(0.97);
    }
    .ob-option.selected {
        border-color: #8B5CF6;
        background: rgba(139, 92, 246, 0.12);
        color: #C4B5FD;
        box-shadow: 0 0 0 1px #8B5CF6, 0 0 24px rgba(139, 92, 246, 0.15);
    }

    /* ──── Text Input ──── */
    .ob-input-wrap { width: 100%; margin-bottom: 24px; }
    .ob-input {
        width: 100%;
        appearance: none;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        background: #1A1A1A;
        color: #F5F5F7;
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        font-weight: 500;
        padding: 18px 20px;
        outline: none;
        transition: all 0.3s ease;
    }
    .ob-input::placeholder { color: rgba(255,255,255,0.2); }
    .ob-input:focus {
        border-color: #8B5CF6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2), 0 0 40px rgba(139, 92, 246, 0.08);
    }
    .ob-input.shake {
        animation: shake 0.4s ease;
        border-color: #EF4444;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
    }

    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
    }

    /* ──── CTA Buttons ──── */
    .ob-cta {
        appearance: none;
        width: 100%;
        border: none;
        border-radius: 16px;
        background: #F5F5F7;
        color: #0A0A0A;
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        font-weight: 600;
        padding: 16px 24px;
        cursor: pointer;
        transition: all 0.25s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .ob-cta:hover { opacity: 0.9; transform: scale(1.01); }
    .ob-cta:active { transform: scale(0.98); }

    .ob-cta--gradient {
        background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);
        color: #fff;
        box-shadow: 0 4px 24px rgba(139, 92, 246, 0.3);
    }
    .ob-cta--gradient:hover { box-shadow: 0 6px 32px rgba(139, 92, 246, 0.45); }

    .ob-cta--ghost {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.5);
        margin-top: 12px;
    }
    .ob-cta--ghost:hover { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.7); }

    /* ──── Typewriter ──── */
    #typewriter-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 120px;
        padding: 0 8px;
    }
    #typewriter-text {
        font-size: 28px;
        font-weight: 600;
        letter-spacing: -0.3px;
        line-height: 1.4;
        color: #F5F5F7;
        text-align: center;
    }
    #typewriter-cursor {
        display: inline-block;
        font-size: 28px;
        font-weight: 300;
        color: #8B5CF6;
        animation: blink 0.8s step-end infinite;
        margin-left: 2px;
    }
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    @media (max-width: 480px) {
        #typewriter-text, #typewriter-cursor { font-size: 22px; }
    }

    /* ──── Diagnostic ──── */
    .ob-diag-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 100px;
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
        color: #A78BFA;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
    }
    .ob-textarea {
        width: 100%;
        appearance: none;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        background: #111111;
        color: #F5F5F7;
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        line-height: 1.6;
        padding: 18px 20px;
        outline: none;
        resize: none;
        min-height: 120px;
        transition: all 0.3s ease;
        margin-bottom: 20px;
    }
    .ob-textarea::placeholder { color: rgba(255,255,255,0.18); }
    .ob-textarea:focus {
        border-color: rgba(139, 92, 246, 0.4);
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.12);
    }

    /* ──── Loader ──── */
    .ob-loader-wrap {
        position: relative;
        width: 80px;
        height: 80px;
        margin-bottom: 32px;
    }
    .ob-pulse-ring {
        position: absolute;
        inset: 0;
        border: 2px solid rgba(139, 92, 246, 0.3);
        border-radius: 50%;
        animation: pulse-ring 1.8s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    }
    .ob-pulse-ring--2 { animation-delay: 0.6s; }
    .ob-pulse-dot {
        position: absolute;
        top: 50%; left: 50%;
        width: 12px; height: 12px;
        margin: -6px 0 0 -6px;
        background: #8B5CF6;
        border-radius: 50%;
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.5);
    }
    @keyframes pulse-ring {
        0% { transform: scale(0.5); opacity: 0.8; }
        100% { transform: scale(1.8); opacity: 0; }
    }
    .ob-loader-text {
        font-size: 15px;
        color: rgba(255,255,255,0.4);
        font-weight: 500;
    }
    .ob-dots::after {
        content: '';
        animation: dots 1.5s steps(4, end) infinite;
    }
    @keyframes dots {
        0% { content: ''; }
        25% { content: '.'; }
        50% { content: '..'; }
        75% { content: '...'; }
    }

    /* ──── Results Dashboard ──── */
    .ob-results {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .ob-result-card {
        background: #141414;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        padding: 18px 20px;
        text-align: left;
    }
    .ob-result-card--score {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .ob-result-card--green { border-left: 3px solid #22C55E; }
    .ob-result-card--red { border-left: 3px solid #EF4444; }
    .ob-result-card--ceda {
        background: linear-gradient(135deg, rgba(139,92,246,0.08) 0%, rgba(59,130,246,0.06) 100%);
        border-color: rgba(139,92,246,0.15);
    }

    .ob-result-label {
        font-size: 14px;
        color: rgba(255,255,255,0.4);
        font-weight: 500;
    }
    .ob-result-value {
        font-size: 24px;
        font-weight: 700;
    }
    .ob-result-value--amber { color: #FBBF24; }

    .ob-result-tag {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        margin-bottom: 8px;
        display: block;
    }
    .ob-result-tag--green { color: #4ADE80; }
    .ob-result-tag--red { color: #F87171; }

    .ob-result-body {
        font-size: 14px;
        color: rgba(255,255,255,0.7);
        line-height: 1.5;
    }

    .ob-chip-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
    .ob-chip {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 100px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        font-size: 12px;
        font-weight: 500;
        color: rgba(255,255,255,0.6);
    }

    /* CEDA */
    .ob-ceda-badge {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    .ob-ceda-label { font-size: 13px; font-weight: 600; color: #A78BFA; }
    .ob-ceda-value {
        font-size: 28px;
        font-weight: 800;
        color: #22C55E;
        text-shadow: 0 0 16px rgba(34, 197, 94, 0.4);
    }
    .ob-ceda-sub { font-size: 12px; color: rgba(255,255,255,0.3); }

    /* Gap Row */
    .ob-gap-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }
    .ob-gap-item { text-align: center; }
    .ob-gap-label { display: block; font-size: 11px; color: rgba(255,255,255,0.3); margin-bottom: 4px; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px; }
    .ob-gap-value { font-size: 22px; font-weight: 700; }
    .ob-gap-value--current { color: #FBBF24; }
    .ob-gap-value--target { color: #22C55E; }
    .ob-gap-value--gap { color: #EF4444; }
    .ob-gap-divider { color: rgba(255,255,255,0.15); font-size: 18px; }

    .ob-bar-track {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.06);
        border-radius: 100px;
        position: relative;
        overflow: visible;
    }
    .ob-bar-fill {
        height: 100%;
        border-radius: 100px;
        background: linear-gradient(90deg, #FBBF24, #F59E0B);
        transition: width 1s ease;
    }
    .ob-bar-marker {
        position: absolute;
        top: -5px;
        width: 3px;
        height: 16px;
        background: #22C55E;
        border-radius: 2px;
        box-shadow: 0 0 8px rgba(34,197,94,0.5);
    }

    /* ──── Paywall ──── */
    .ob-paywall-icon {
        font-size: 48px;
        margin-bottom: 20px;
        background: linear-gradient(135deg, #8B5CF6, #C084FC);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 24px rgba(139,92,246,0.3));
    }
    .ob-pricing-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        width: 100%;
        margin-top: 24px;
    }
    .ob-pricing-card {
        background: #141414;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        padding: 24px 16px;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .ob-pricing-card--popular {
        border-color: rgba(139,92,246,0.3);
        background: rgba(139,92,246,0.06);
        box-shadow: 0 0 30px rgba(139,92,246,0.08);
    }
    .ob-pricing-badge {
        position: absolute;
        top: 0; right: 0;
        background: #8B5CF6;
        color: #fff;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
        padding: 4px 10px;
        border-radius: 0 18px 0 10px;
    }
    .ob-pricing-period { font-size: 13px; color: rgba(255,255,255,0.35); margin-bottom: 6px; }
    .ob-pricing-amount { font-size: 32px; font-weight: 800; color: #F5F5F7; }
    .ob-pricing-unit { font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.3); }
    .ob-pricing-save { font-size: 11px; color: #22C55E; font-weight: 600; margin-top: 4px; }
</style>

<!-- ═══════════════════════  SCRIPT  ═══════════════════════ -->
<script>
    // ── Loop Breaker ──
    const ATTEMPTS_KEY = 'onboarding_attempts';
    let attempts = parseInt(localStorage.getItem(ATTEMPTS_KEY) || '0', 10);
    attempts++;
    localStorage.setItem(ATTEMPTS_KEY, String(attempts));
    if (attempts >= 6) {
        window.location.href = '/tools/keyword-optimizer';
    }

    // ── State ──
    const state = {
        class_level: '', full_name: '', code_mix_lang: '',
        tuition_type: '', acquisition_channel: '', exam_timeline: '',
        weak_subject: '', target_score: ''
    };

    let currentStep = 1;
    const totalQuestionSteps = 8;

    // ── DOM Refs ──
    const allSteps   = document.querySelectorAll('.ob-step');
    const progressBar = document.getElementById('ob-progress-bar');

    // ── Transition Engine ──
    function goToStep(n) {
        const current = document.querySelector('.ob-step.active');
        if (current) {
            current.classList.remove('visible');
            setTimeout(() => {
                current.classList.remove('active');
                showStep(n);
            }, 400);
        } else {
            showStep(n);
        }
    }

    function showStep(n) {
        currentStep = n;
        const next = document.querySelector(`.ob-step[data-step="${n}"]`);
        if (!next) return;
        next.classList.add('active');
        // Force reflow
        void next.offsetWidth;
        requestAnimationFrame(() => next.classList.add('visible'));

        // Update progress
        if (n <= totalQuestionSteps) {
            progressBar.style.width = `${(n / totalQuestionSteps) * 100}%`;
        } else {
            progressBar.style.width = '100%';
        }

        // Step-specific hooks
        if (n === 9) startTypewriter();
        if (n === 10) setupDiagnostic();
        if (n === 11) startMockAnalysis();
        if (n === 12) setupResults();
    }

    // ── Initial mount ──
    requestAnimationFrame(() => {
        const first = document.querySelector('.ob-step[data-step="1"]');
        if (first) {
            void first.offsetWidth;
            first.classList.add('visible');
        }
        progressBar.style.width = `${(1 / totalQuestionSteps) * 100}%`;
    });

    // ── Option Buttons ──
    document.querySelectorAll('.ob-option').forEach(btn => {
        btn.addEventListener('click', () => {
            const field = btn.getAttribute('data-field');
            const val   = btn.getAttribute('data-val');

            // Visual
            btn.parentElement.querySelectorAll('.ob-option').forEach(s => s.classList.remove('selected'));
            btn.classList.add('selected');

            state[field] = val;

            setTimeout(() => goToStep(currentStep + 1), 350);
        });
    });

    // ── Name Input ──
    const nameInput = document.getElementById('ob-name');
    const nameBtn   = document.getElementById('ob-name-next');

    nameBtn?.addEventListener('click', () => {
        const val = nameInput.value.trim();
        if (!val) {
            nameInput.classList.add('shake');
            setTimeout(() => nameInput.classList.remove('shake'), 500);
            return;
        }
        state.full_name = val;
        goToStep(currentStep + 1);
    });

    nameInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') nameBtn?.click();
    });

    // ── Typewriter Engine ──
    function startTypewriter() {
        const textEl   = document.getElementById('typewriter-text');
        const cursorEl = document.getElementById('typewriter-cursor');

        const lines = [
            `${state.full_name}, your goal is ${state.target_score}.`,
            "Most students don't lose marks because they don't study.",
            "They lose marks because their answers miss what examiners expect.",
            "Let's find where your marks are going."
        ];

        let lineIndex = 0;

        function typeLine() {
            if (lineIndex >= lines.length) {
                cursorEl.style.display = 'none';
                setTimeout(() => goToStep(10), 600);
                return;
            }

            const line = lines[lineIndex];
            let charIndex = 0;
            textEl.textContent = '';
            textEl.style.opacity = '1';
            cursorEl.style.display = 'inline-block';

            function typeChar() {
                if (charIndex < line.length) {
                    textEl.textContent += line[charIndex];
                    charIndex++;
                    setTimeout(typeChar, 35);
                } else {
                    // Pause, then fade out
                    setTimeout(() => {
                        textEl.style.transition = 'opacity 0.8s ease';
                        textEl.style.opacity = '0';
                        setTimeout(() => {
                            textEl.style.transition = 'none';
                            lineIndex++;
                            typeLine();
                        }, 900);
                    }, 1600);
                }
            }
            typeChar();
        }

        // Small pause before starting
        setTimeout(typeLine, 800);
    }

    // ── Diagnostic Input ──
    function setupDiagnostic() {
        const prompt = document.getElementById('diag-prompt');
        const questions = {
            'Science': 'Explain the process of Photosynthesis.',
            'Maths': 'Explain the Pythagorean theorem and its applications.',
            'English': "Discuss the main themes in Robert Frost's poetry.",
            'Social Science': 'Discuss the causes and effects of the French Revolution.'
        };
        const subj = state.weak_subject || 'Science';
        prompt.textContent = questions[subj] || questions['Science'];

        // Auto-expand textarea
        const ta = document.getElementById('diag-textarea');
        ta?.addEventListener('input', () => {
            ta.style.height = 'auto';
            ta.style.height = ta.scrollHeight + 'px';
        });
    }

    document.getElementById('btn-analyze')?.addEventListener('click', () => {
        goToStep(11);
    });

    // ── Mock Analysis (3s spinner) ──
    function startMockAnalysis() {
        setTimeout(() => goToStep(12), 3000);
    }

    // ── Results ──
    function setupResults() {
        const targetNum = parseInt(state.target_score?.replace('%','').replace('Above ','')) || 90;
        const gap = Math.max(0, targetNum - 60);

        document.getElementById('result-target').textContent = state.target_score || '90%';
        document.getElementById('result-gap').textContent = gap + '%';

        const marker = document.getElementById('result-bar-target');
        if (marker) marker.style.left = Math.min(targetNum, 100) + '%';
    }

    document.getElementById('btn-results-next')?.addEventListener('click', () => goToStep(13));

    // ── Paywall ──
    document.getElementById('btn-free')?.addEventListener('click', () => {
        localStorage.removeItem(ATTEMPTS_KEY);
        window.location.href = '/dashboard';
    });
</script>
